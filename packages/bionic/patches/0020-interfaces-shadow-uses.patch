+// joe Linux: getusershell(3), setusershell() and endusershell(), and
+// explicit_bzero(3), which glibc has and bionic lacks; shadow's tools use
+// them. Like glibc's, getusershell() returns the first word of each line of
+// /etc/shells that starts, after anything else, with '/' (comments, after
+// '#', excepted), and /bin/sh and /bin/csh when there is no /etc/shells.
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+namespace {
+
+char* g_text = nullptr;      // /etc/shells, its words NUL-terminated in place
+char** g_shells = nullptr;   // the words, NULL-terminated
+size_t g_next = 0;
+char* g_default[] = {const_cast<char*>("/bin/sh"), const_cast<char*>("/bin/csh"), nullptr};
+
+char** read_shells() {
+  FILE* fp = fopen("/etc/shells", "re");
+  if (fp == nullptr) return g_default;
+  size_t capacity = 0;
+  ssize_t size = getdelim(&g_text, &capacity, '\0', fp);
+  fclose(fp);
+  if (size <= 0) {
+    free(g_text);
+    g_text = nullptr;
+    size = 0;
+  }
+  size_t lines = 1;
+  for (ssize_t i = 0; i < size; ++i) lines += (g_text[i] == '\n');
+  g_shells = static_cast<char**>(calloc(lines + 1, sizeof(char*)));
+  if (g_shells == nullptr) return g_default;
+  size_t n = 0;
+  char* p = g_text;
+  char* end = g_text + size;
+  while (p < end) {
+    char* eol = static_cast<char*>(memchr(p, '\n', end - p));
+    if (eol == nullptr) eol = end;
+    char* s = p;
+    while (s < eol && *s != '#' && *s != '/') ++s;
+    if (s < eol && *s == '/') {
+      char* e = s;
+      while (e < eol && *e != '#' && *e != ' ' && *e != '\t' && *e != '\r') ++e;
+      *e = '\0';
+      g_shells[n++] = s;
+    }
+    p = eol + 1;
+  }
+  g_shells[n] = nullptr;
+  return g_shells;
+}
+
+}  // namespace
+
+char* getusershell() {
+  if (g_shells == nullptr) g_shells = read_shells();
+  char* shell = g_shells[g_next];
+  if (shell != nullptr) ++g_next;
+  return shell;
+}
+
+void endusershell() {
+  if (g_shells != g_default) free(g_shells);
+  free(g_text);
+  g_text = nullptr;
+  g_shells = nullptr;
+  g_next = 0;
+}
+
+void setusershell() {
+  endusershell();
+}
+
+void explicit_bzero(void* dst, size_t n) {
+  memset_explicit(dst, 0, n);
+}

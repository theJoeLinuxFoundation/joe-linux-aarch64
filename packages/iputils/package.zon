.{
    .name = "iputils",
    .version = "20250605",
    .release = 1,
    .description = "Network diagnostics: arping, tracepath and clockdiff (ping comes from inetutils)",
    .license = "GPL-2.0-or-later AND BSD-3-Clause",
    .sources = .{
        .{ .url = "https://github.com/iputils/iputils/releases/download/20250605/iputils-20250605.tar.xz", .sha256 = "6f213700dbf96b5cc4499ca70cb15ecd69c09f405b06785bb4a1a10b572b6276" },
    },
    .depends = .{ "bionic", "libcap", "libidn2", "libintl" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext" },
    // Set-uid root. Run by an ordinary user, a program holds only what its
    // seal declares (packages/linux/joe-lsm), so these declare all;
    // narrower lists are rule 3's work.
    .operations = .{
        .{ .programs = .{ "usr/bin/clockdiff" }, .allow = .{"all"} },
    },
}

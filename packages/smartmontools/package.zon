.{
    .name = "smartmontools",
    .version = "7.5",
    .release = 1,
    .description = "S.M.A.R.T. disk monitoring tools: smartctl and the smartd daemon",
    .license = "GPL-2.0-or-later",
    .sources = .{
        // Checked against the release's smartmontools-7.5.tar.gz.md5.
        .{ .url = "https://github.com/smartmontools/smartmontools/releases/download/RELEASE_7_5/smartmontools-7.5.tar.gz", .sha256 = "690b83ca331378da9ea0d9d61008c4b22dde391387b9bbad7f29387f2595f76e" },
    },
    // libcap-ng: smartd drops capabilities it does not need (-C);
    // update-smart-drivedb downloads the drive
    // database with curl and checks its signature with gpg.
    .depends = .{ "bionic", "llvm-runtimes", "libcap-ng", "curl", "gnupg" },
    .build_depends = .{"pkgconf"},
}

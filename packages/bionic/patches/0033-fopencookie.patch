+// joe Linux: fopencookie(3), glibc's custom streams, which musl has too and
+// bionic lacks; procps reads /proc through one. The stream is BSD's
+// funopen64(3), which bionic has, with the cookie and the functions in a
+// block that closing the stream frees.
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+namespace {
+
+struct cookie_stream {
+  void* cookie;
+  cookie_io_functions_t funcs;
+};
+
+int cookie_read(void* p, char* buf, int n) {
+  auto s = static_cast<cookie_stream*>(p);
+  // As glibc: without a read function, the stream is at its end.
+  if (s->funcs.read == nullptr) return 0;
+  return s->funcs.read(s->cookie, buf, n);
+}
+
+int cookie_write(void* p, const char* buf, int n) {
+  auto s = static_cast<cookie_stream*>(p);
+  // As glibc: without a write function, what is written is thrown away.
+  if (s->funcs.write == nullptr) return n;
+  return s->funcs.write(s->cookie, buf, n);
+}
+
+fpos64_t cookie_seek(void* p, fpos64_t offset, int whence) {
+  auto s = static_cast<cookie_stream*>(p);
+  off64_t position = offset;
+  if (s->funcs.seek(s->cookie, &position, whence) != 0) return -1;
+  return position;
+}
+
+int cookie_close(void* p) {
+  auto s = static_cast<cookie_stream*>(p);
+  int result = s->funcs.close != nullptr ? s->funcs.close(s->cookie) : 0;
+  free(s);
+  return result;
+}
+
+}  // namespace
+
+FILE* fopencookie(void* cookie, const char* mode, cookie_io_functions_t funcs) {
+  // The access fopen(3)'s mode gives, read as glibc reads it: "r", "w" or
+  // "a", then a "+" as the second or third character. "a" has nothing to
+  // do: the write function decides where what it is given goes.
+  bool readable, writable;
+  switch (mode[0]) {
+    case 'r':
+      readable = true;
+      writable = false;
+      break;
+    case 'w':
+    case 'a':
+      readable = false;
+      writable = true;
+      break;
+    default:
+      errno = EINVAL;
+      return nullptr;
+  }
+  if (mode[1] == '+' || (mode[1] != '\0' && mode[2] == '+')) readable = writable = true;
+
+  auto s = static_cast<cookie_stream*>(malloc(sizeof(cookie_stream)));
+  if (s == nullptr) return nullptr;
+  s->cookie = cookie;
+  s->funcs = funcs;
+  // Without a seek function, the stream cannot seek.
+  FILE* fp = funopen64(s, readable ? cookie_read : nullptr, writable ? cookie_write : nullptr,
+                       funcs.seek != nullptr ? cookie_seek : nullptr, cookie_close);
+  if (fp == nullptr) free(s);
+  return fp;
+}
diff --git i/libc/include/stdio.h w/libc/include/stdio.h
index d64658c..119e8ec 100644
--- i/libc/include/stdio.h
+++ w/libc/include/stdio.h
@@ -331,6 +331,33 @@ __nodiscard FILE* _Nullable funopen64(const void* _Nullable __cookie,

@@ -235,6 +235,41 @@
 int sync_file_range(int __fd, off64_t __offset, off64_t __length, unsigned int __flags) __INTRODUCED_IN(26);
 #endif
 
+#if defined(__USE_GNU)
+/** The size of the largest file handle (joe Linux, as glibc). */
+#define MAX_HANDLE_SZ 128
+
+/**
+ * A file handle, as name_to_handle_at() makes it and open_by_handle_at()
+ * takes it: `handle_bytes` bytes of `f_handle` (joe Linux, as glibc).
+ */
+struct file_handle {
+  unsigned int handle_bytes;
+  int handle_type;
+  unsigned char f_handle[0];
+};
+
+/**
+ * [name_to_handle_at(2)](https://man7.org/linux/man-pages/man2/name_to_handle_at.2.html)
+ * returns a handle for a file and the id of the mount it is on.
+ *
+ * Returns 0 on success and returns -1 and sets `errno` on failure.
+ *
+ * Available when compiling with `_GNU_SOURCE` (joe Linux).
+ */
+int name_to_handle_at(int __dir_fd, const char* _Nonnull __path, struct file_handle* _Nonnull __handle, int* _Nonnull __mount_id, int __flags);
+
+/**
+ * [open_by_handle_at(2)](https://man7.org/linux/man-pages/man2/open_by_handle_at.2.html)
+ * opens the file a handle from name_to_handle_at() refers to.
+ *
+ * Returns a new file descriptor on success and returns -1 and sets `errno` on failure.
+ *
+ * Available when compiling with `_GNU_SOURCE` (joe Linux).
+ */
+int open_by_handle_at(int __mount_fd, struct file_handle* _Nonnull __handle, int __flags);
+#endif
+
 #if defined(__BIONIC_INCLUDE_FORTIFY_HEADERS)
 #include <bits/fortify/fcntl.h>
 #endif

joe Linux: <sys/quota.h> with both the kernel's names, struct if_dqblk and if_dqinfo, and
glibc's, struct dqblk and dqinfo, as glibc's has them; Linux-PAM's pam_setquota uses the kernel's.

diff --git i/libc/include/sys/quota.h w/libc/include/sys/quota.h
--- i/libc/include/sys/quota.h
+++ w/libc/include/sys/quota.h
@@ -35,12 +35,35 @@
 
 #include <sys/cdefs.h>
 
-// The uapi header uses different names from userspace, oddly.
-#define if_dqblk dqblk
-#define if_dqinfo dqinfo
 #include <linux/quota.h>
-#undef if_dqblk
-#undef if_dqinfo
+
+/*
+ * joe Linux: the kernel's names, struct if_dqblk and struct if_dqinfo, and
+ * beside them glibc's, struct dqblk and struct dqinfo, of the same layout,
+ * as glibc's <sys/quota.h> has both (Linux-PAM's pam_setquota uses the
+ * kernel's).
+ */
+
+/** A user's or group's quota, as quotactl() takes and returns it. */
+struct dqblk {
+  __u64 dqb_bhardlimit;
+  __u64 dqb_bsoftlimit;
+  __u64 dqb_curspace;
+  __u64 dqb_ihardlimit;
+  __u64 dqb_isoftlimit;
+  __u64 dqb_curinodes;
+  __u64 dqb_btime;
+  __u64 dqb_itime;
+  __u32 dqb_valid;
+};
+
+/** A file system's quota grace times and flags, as quotactl() takes and returns them. */
+struct dqinfo {
+  __u64 dqi_bgrace;
+  __u64 dqi_igrace;
+  __u32 dqi_flags;
+  __u32 dqi_valid;
+};
 
 __BEGIN_DECLS
 

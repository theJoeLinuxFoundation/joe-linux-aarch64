+/*
+ * joe Linux: /etc/ethers, which maps Ethernet addresses to host names, as
+ * glibc reads it: each line an address, blanks and a name ('#' starts a
+ * comment).
+ */
+
+/**
+ * [ether_line(3)](https://man7.org/linux/man-pages/man3/ether_line.3.html)
+ * parses a line of /etc/ethers into an address and a host name, which must
+ * have room for the name.
+ *
+ * Returns 0 on success, and -1 if the line is not an entry.
+ */
+int ether_line(const char* _Nonnull __line, struct ether_addr* _Nonnull __addr, char* _Nonnull __hostname);
+
+/**
+ * [ether_ntohost(3)](https://man7.org/linux/man-pages/man3/ether_ntohost.3.html)
+ * finds the host name of an address in /etc/ethers.
+ *
+ * Returns 0 on success, and -1 if there is none.
+ */
+int ether_ntohost(char* _Nonnull __hostname, const struct ether_addr* _Nonnull __addr);
+
+/**
+ * [ether_hostton(3)](https://man7.org/linux/man-pages/man3/ether_hostton.3.html)
+ * finds the address of a host name in /etc/ethers.
+ *
+ * Returns 0 on success, and -1 if there is none.
+ */
+int ether_hostton(const char* _Nonnull __hostname, struct ether_addr* _Nonnull __addr);
+
 __END_DECLS

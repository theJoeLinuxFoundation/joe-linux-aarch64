.{
    .name = "libarchive",
    .version = "3.8.11",
    .release = 1,
    .description = "Library and tools (bsdtar, bsdcpio, bsdcat, bsdunzip) for reading and writing archives",
    .license = "BSD-2-Clause",
    .sources = .{
        .{ .url = "https://github.com/libarchive/libarchive/releases/download/v3.8.11/libarchive-3.8.11.tar.xz", .sha256 = "a3dc0872b1b39da34dc18ef1b944f0f11ffd37425d70ae04be679279f1cf43d2" },
    },
    .depends = .{ "bionic", "acl", "attr", "bzip2", "expat", "lz4", "openssl", "xz", "zlib", "zstd" },
    .build_depends = .{"pkgconf"},
}

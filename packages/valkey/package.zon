.{
    .name = "valkey",
    .version = "9.1.3",
    .release = 1,
    .description = "Valkey, the Redis-compatible in-memory data structure server, with valkey-cli and Sentinel",
    .license = "BSD-3-Clause",
    .sources = .{
        // Checked against the SHA-256 in upstream's valkey-hashes
        // repository.
        .{ .url = "https://github.com/valkey-io/valkey/archive/9.1.3/valkey-9.1.3.tar.gz", .sha256 = "184e34ed2d9b51879b682b5b15205e2b9d677c60280e3cb453be8f520d04e293" },
    },
    // Its jemalloc, Lua, libvalkey and linenoise are bundled and linked
    // statically (see build.sh).
    .depends = .{ "bionic", "openssl" },
    .build_depends = .{"pkgconf"},
}

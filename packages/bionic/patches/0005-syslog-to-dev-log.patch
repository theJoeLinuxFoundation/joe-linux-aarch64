 #include <unistd.h>
 
-#include <async_safe/log.h>
+#include "private/ErrnoRestorer.h"
 
+static pthread_mutex_t syslog_lock = PTHREAD_MUTEX_INITIALIZER;
 static const char* syslog_log_tag = nullptr;
-// The "mask" is of _enabled_ log priorities, and defaults to all.
 static int syslog_priority_mask = LOG_UPTO(LOG_DEBUG);
 static int syslog_options = 0;
+static int syslog_facility = LOG_USER;
+static int syslog_fd = -1;
 
-void closelog() {
-  syslog_log_tag = nullptr;
-  syslog_options = 0;
+static const sockaddr_un kLogAddress = {AF_UNIX, "/dev/log"};
+
+// With syslog_lock held.
+static void syslog_connect_locked() {
+  if (syslog_fd == -1) {
+    syslog_fd = socket(AF_UNIX, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+    if (syslog_fd == -1) return;
+  }
+  // A failed connect leaves the socket to try again with the next message,
+  // so that messages from before the logger starts are not all lost... at
+  // least not those sent after it does.
+  connect(syslog_fd, reinterpret_cast<const sockaddr*>(&kLogAddress), sizeof(kLogAddress));
 }
 
-void openlog(const char* log_tag, int options, int /*facility*/) {
+void closelog() {
+  pthread_mutex_lock(&syslog_lock);
+  if (syslog_fd != -1) {
+    close(syslog_fd);
+    syslog_fd = -1;
+  }
+  syslog_log_tag = nullptr;
+  syslog_options = 0;
+  pthread_mutex_unlock(&syslog_lock);
+}
+
+void openlog(const char* log_tag, int options, int facility) {
+  pthread_mutex_lock(&syslog_lock);
   syslog_log_tag = log_tag;
   syslog_options = options;
+  if (facility != 0) syslog_facility = facility & LOG_FACMASK;
+  if ((options & LOG_NDELAY) != 0) syslog_connect_locked();
+  pthread_mutex_unlock(&syslog_lock);
 }
 
 int setlogmask(int new_mask) {
+  pthread_mutex_lock(&syslog_lock);
   int old_mask = syslog_priority_mask;
   // 0 is used to query the current mask.
   if (new_mask != 0) {
     syslog_priority_mask = new_mask;
   }
+  pthread_mutex_unlock(&syslog_lock);
   return old_mask;
 }
 

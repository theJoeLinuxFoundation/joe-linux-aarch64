.{
    .name = "glib",
    .version = "2.90.1",
    .release = 1,
    .description = "Core GLib, GObject, GIO and threading libraries",
    .license = "LGPL-2.1-or-later AND LGPL-2.0-or-later AND GPL-2.0-or-later AND MIT",
    .sources = .{
        .{ .url = "https://download.gnome.org/sources/glib/2.90/glib-2.90.1.tar.xz", .sha256 = "93c941aa17d5eb1d53fe838365f29a8b4e539c222a256d974ec8f30fc413e396" },
    },
    // GIO uses libmount and zlib. The code generators use Python.
    .depends = .{ "bionic", "libffi", "pcre2", "zlib", "util-linux", "libintl", "python" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext" },
}

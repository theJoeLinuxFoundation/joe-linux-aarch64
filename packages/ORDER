# Build order, one package per line. The base system replaces the
# bootstrap's temporary tools one by one, in the order of Linux From
# Scratch's chapter 8, with bionic and LLVM's runtimes in place of glibc and
# GCC. "build-only" packages are built but not installed into the build root.
iana-etc
bionic
llvm-runtimes
zlib
bzip2
xz
zstd
file
readline
m4
bc
flex
pkgconf
attr
acl
libcap
libxcrypt
gawk
ncurses
bash
sed
gettext
bison
grep
libtool
gdbm
gperf
expat
less
perl
autoconf
automake
libffi
openssl
# util-linux before Python, not after it as in Linux From Scratch: Python
# depends on its libuuid (the _uuid module), as on gdbm (_gdbm, _dbm).
util-linux
python
flit-core
packaging
wheel
setuptools
ninja
meson
linux-pam
shadow
kmod
coreutils
diffutils
findutils
gzip
iproute2
make
patch
tar
# eudev before btrfs-progs, which links its libudev (as systemd's in joe Linux).
eudev
btrfs-progs

+// joe Linux: syslog(3) as on other Linux systems. Messages go to the system
+// logger's socket, /dev/log, as RFC 3164 datagrams; Android's version wrote
+// them to logd instead and ignored the facility.
+
 #include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
 #include <stdlib.h>
 #include <string.h>

+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+ * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+
+#pragma once
+
+/**
+ * @file mqueue.h
+ * @brief POSIX message queues (joe Linux, as glibc and musl have them).
+ */
+
+#include <sys/cdefs.h>
+
+#include <fcntl.h>
+#include <signal.h>
+#include <sys/types.h>
+#include <time.h>
+#include <linux/mqueue.h>
+
+__BEGIN_DECLS
+
+/** A message queue descriptor: a file descriptor. */
+typedef int mqd_t;
+
+/**
+ * [mq_open(3)](https://man7.org/linux/man-pages/man3/mq_open.3.html)
+ * opens the message queue `__name`, which begins with a slash. With
+ * `O_CREAT`, two more arguments are the new queue's mode and its attributes
+ * (a `struct mq_attr*`, or NULL for the defaults).
+ *
+ * Returns a message queue descriptor on success and returns -1 and sets `errno` on failure.
+ */
+mqd_t mq_open(const char* _Nonnull __name, int __flags, ...);
+
+/**
+ * [mq_close(3)](https://man7.org/linux/man-pages/man3/mq_close.3.html)
+ * closes a message queue descriptor.
+ *
+ * Returns 0 on success and returns -1 and sets `errno` on failure.
+ */
+int mq_close(mqd_t __mq);
+
+/**
+ * [mq_unlink(3)](https://man7.org/linux/man-pages/man3/mq_unlink.3.html)
+ * removes the message queue `__name`; it goes when the last descriptor is closed.
+ *
+ * Returns 0 on success and returns -1 and sets `errno` on failure.
+ */
+int mq_unlink(const char* _Nonnull __name);
+
+/**
+ * [mq_getattr(3)](https://man7.org/linux/man-pages/man3/mq_getattr.3.html)
+ * gets a message queue's attributes.
+ *
+ * Returns 0 on success and returns -1 and sets `errno` on failure.
+ */
+int mq_getattr(mqd_t __mq, struct mq_attr* _Nonnull __attr);
+
+/**
+ * [mq_setattr(3)](https://man7.org/linux/man-pages/man3/mq_setattr.3.html)
+ * sets a message queue descriptor's flags (only `O_NONBLOCK`), returning the
+ * old attributes in `__old_attr` if it is not NULL.
+ *
+ * Returns 0 on success and returns -1 and sets `errno` on failure.
+ */
+int mq_setattr(mqd_t __mq, const struct mq_attr* _Nonnull __new_attr, struct mq_attr* _Nullable __old_attr);
+
+/**
+ * [mq_notify(3)](https://man7.org/linux/man-pages/man3/mq_notify.3.html)
+ * asks to be notified, once, when a message arrives in an empty queue; NULL
+ * cancels the request.
+ *
+ * Returns 0 on success and returns -1 and sets `errno` on failure.
+ */
+int mq_notify(mqd_t __mq, const struct sigevent* _Nullable __event);
+
+/**
+ * [mq_send(3)](https://man7.org/linux/man-pages/man3/mq_send.3.html)
+ * adds a message to a queue.
+ *
+ * Returns 0 on success and returns -1 and sets `errno` on failure.
+ */
+int mq_send(mqd_t __mq, const char* _Nonnull __msg, size_t __length, unsigned int __priority);
+
+/**
+ * [mq_timedsend(3)](https://man7.org/linux/man-pages/man3/mq_timedsend.3.html)
+ * is mq_send() waiting at most until `__timeout` (CLOCK_REALTIME) for room.
+ *
+ * Returns 0 on success and returns -1 and sets `errno` on failure.
+ */
+int mq_timedsend(mqd_t __mq, const char* _Nonnull __msg, size_t __length, unsigned int __priority, const struct timespec* _Nullable __timeout);
+
+/**
+ * [mq_receive(3)](https://man7.org/linux/man-pages/man3/mq_receive.3.html)
+ * takes the oldest message of the highest priority from a queue.
+ *
+ * Returns the message's length on success and returns -1 and sets `errno` on failure.
+ */
+ssize_t mq_receive(mqd_t __mq, char* _Nonnull __msg, size_t __length, unsigned int* _Nullable __priority);
+
+/**
+ * [mq_timedreceive(3)](https://man7.org/linux/man-pages/man3/mq_timedreceive.3.html)
+ * is mq_receive() waiting at most until `__timeout` (CLOCK_REALTIME) for a message.
+ *
+ * Returns the message's length on success and returns -1 and sets `errno` on failure.
+ */
+ssize_t mq_timedreceive(mqd_t __mq, char* _Nonnull __msg, size_t __length, unsigned int* _Nullable __priority, const struct timespec* _Nullable __timeout);
+
+__END_DECLS

.{
    .name = "linux-pam",
    .version = "1.7.3",
    .release = 3,
    .description = "Pluggable Authentication Modules: libpam, the standard modules and base configuration",
    .license = "BSD-3-Clause OR GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://github.com/linux-pam/linux-pam/releases/download/v1.7.3/Linux-PAM-1.7.3.tar.xz", .sha256 = "2ce4765fd49df6693771ef2941f81e33d8ee14b94a81a5c7b369aa3b137b85a5" },
        .{ .url = "https://anduin.linuxfromscratch.org/BLFS/Linux-PAM/Linux-PAM-1.7.3-docs.tar.xz", .sha256 = "2ea986ae2276ab46332eb2709806aefad05f7985801c8f1313acb9d00302dace" },
    },
    .depends = .{ "bionic", "libxcrypt" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "gettext", "flex", "bison" },
    // Set-uid root. Run by an ordinary user, a program holds only what its
    // seal declares (packages/linux/joe-lsm), so these declare all;
    // narrower lists are rule 3's work.
    // unix_chkpwd checks passwords for programs that are not root (the
    // screen lock).
    .operations = .{
        .{ .programs = .{ "usr/sbin/unix_chkpwd" }, .allow = .{"all"} },
    },
}

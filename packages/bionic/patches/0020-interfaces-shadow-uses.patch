+/**
+ * [explicit_bzero(3)](https://man7.org/linux/man-pages/man3/explicit_bzero.3.html)
+ * zeroes the next `n` bytes of `dst`, and won't be optimized out by the
+ * compiler (joe Linux, as glibc and the BSDs: memset_explicit() with zero).
+ */
+void explicit_bzero(void* _Nonnull __dst, size_t __n);
+
+#if defined(__USE_GNU)
+/**
+ * strdupa(3) is strdup() on the stack: the copy lasts until the calling
+ * function returns (joe Linux, as glibc's macro).
+ */
+#define strdupa(__s) \
+  (__extension__({ \
+    const char* __strdupa_s = (__s); \
+    size_t __strdupa_n = strlen(__strdupa_s) + 1; \
+    (char*)__builtin_memcpy(__builtin_alloca(__strdupa_n), __strdupa_s, __strdupa_n); \
+  }))
+
+/**
+ * strndupa(3) is strndup() on the stack: the copy lasts until the calling
+ * function returns (joe Linux, as glibc's macro).
+ */
+#define strndupa(__s, __n) \
+  (__extension__({ \
+    const char* __strndupa_s = (__s); \
+    size_t __strndupa_n = strnlen(__strndupa_s, (__n)); \
+    char* __strndupa_d = (char*)__builtin_alloca(__strndupa_n + 1); \
+    __strndupa_d[__strndupa_n] = '\0'; \
+    (char*)__builtin_memcpy(__strndupa_d, __strndupa_s, __strndupa_n); \
+  }))
+#endif
+

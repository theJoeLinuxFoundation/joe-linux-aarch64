    },
    // The kernel's headers, as bionic ships them, are part of this package.
    // liblog, part of this package for programs written for Android (Rust's
    // standard library links it), uses libc++; LLVM's runtimes depend on
    // bionic in turn.
    .depends = .{"llvm-runtimes"},
    .build_depends = .{ "python", "ninja", "cmake" },
}

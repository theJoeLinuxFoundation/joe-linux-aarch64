joe Linux: wrappers for the Linux system calls glibc has and Android does not allow apps:
fanotify (<sys/fanotify.h>), file handles (name_to_handle_at, open_by_handle_at) and
cachestat. util-linux uses them.

diff --git i/libc/SYSCALLS.TXT w/libc/SYSCALLS.TXT
--- i/libc/SYSCALLS.TXT
+++ w/libc/SYSCALLS.TXT
@@ -123,6 +123,12 @@
 copy_file_range(int, off64_t*, int, off64_t*, size_t, unsigned int) all
 __getpid:getpid()  all
 memfd_create(const char*, unsigned) all
+# joe Linux: Linux's, which Android does not allow apps.
+cachestat(unsigned int, struct cachestat_range*, struct cachestat*, unsigned int) all
+fanotify_init(unsigned int, unsigned int) all
+fanotify_mark(int, unsigned int, uint64_t, int, const char*) all
+name_to_handle_at(int, const char*, struct file_handle*, int*, int) all
+open_by_handle_at(int, struct file_handle*, int) all
 munmap(void*, size_t)  all
 msync(const void*, size_t, int)    all
 mprotect(const void*, size_t, int)  all

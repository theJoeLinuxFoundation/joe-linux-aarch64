// Modules joe Linux supplies in place of the parts of AOSP that bionic's
// build files refer to but that joe does not build from AOSP. Read after
// every upstream Android.bp; a module here replaces one of the same name.

// From build/soong: host support switches only.
cc_defaults {
    name: "linux_bionic_supported",
}

// Android IDs (AID_SYSTEM = 1000, AID_SHELL = 2000, ...) are Android's fixed
// accounts; on joe Linux every account is in /etc/passwd and /etc/group, as
// bionic already arranges for builds that are not Android's own.
genrule {
    name: "generated_android_ids",
    out: ["generated_android_ids.h"],
    srcs: ["android_ids.h"],
    cmd: "cp $(in) $(out)",
}

// bionic's Rust: the ICU4X wrapper, and the allocator and panic handler that
// exist so that it can be linked into libc. joe's libicu4x_bionic is C, with
// tables generated from the Unicode Character Database (unicode/gen.py), so
// the other two are empty.
cc_library_static {
    name: "libicu4x_bionic",
    defaults: ["libc_defaults"],
    // Generated by unicode/gen.py from the Unicode Character Database
    // before the build.
    srcs: ["unicode/icu4x.c"],
}

cc_library_static {
    name: "libbionic_panic_abort",
}

cc_library_static {
    name: "liblibc_alloc_rust",
}

cc_library_static {
    name: "libstd",
}

// The dynamic linker can load libraries stored uncompressed inside zip files
// (APKs), with "!/" in a path. joe has no APKs: the linker's calls into
// libziparchive fail as they would for a file that is not a zip archive.
cc_library_static {
    name: "libziparchive",
    srcs: ["ziparchive.cpp"],
    // The header's C++ standard library; nothing of libc++ is linked.
    stl: "libc++",
    export_include_dirs: ["../system/libziparchive/include"],
    header_libs: ["libbase_headers"],
    cflags: ["-Wall", "-Werror"],
}

// The linker's static libraries name zlib for libziparchive, which joe
// stubs; nothing in the linker uses it.
cc_library_static {
    name: "libz",
}

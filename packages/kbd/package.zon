.{
    .name = "kbd",
    .version = "2.10.0",
    .release = 1,
    .description = "Console keyboard maps, fonts and the tools that load them",
    .license = "GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://www.kernel.org/pub/linux/utils/kbd/kbd-2.10.0.tar.xz", .sha256 = "6e5ca4f8d76ee9e3a8db700b667f13e12aac9933828a64e1aaad93d26be9b479" },
        .{ .url = "https://www.linuxfromscratch.org/patches/lfs/development/kbd-2.10.0-backspace-1.patch", .sha256 = "8be28dcb11420624a500f2ea4fe975f771174bffee50e54ec8cd295a2dec104e" },
    },
    // Compressed keymaps and fonts are read with whichever of these
    // libraries configure finds, and it finds them all.
    .depends = .{ "bionic", "zlib", "bzip2", "xz", "zstd", "libintl" },
    .build_depends = .{ "pkgconf", "gettext" },
}

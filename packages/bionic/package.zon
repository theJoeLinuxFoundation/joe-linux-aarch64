.{
    .name = "bionic",
    .version = "17.0.0_r1",
    .release = 31,
    .description = "bionic, Android's C library, as joe Linux's: libc, libm, libdl and the dynamic linker",
    .license = "BSD-2-Clause AND BSD-3-Clause AND ISC AND MIT AND Apache-2.0",
    // AOSP's bionic and the libraries its build uses, as `git archive` tars
    // of the commits tagged android-17.0.0_r1 (aosp.list); the Unicode
    // Character Database, for its character classes; LLVM's source, for the
    // libunwind and libc++ the build links. These are the files of
    // bootstrap/sources, checked the same way.

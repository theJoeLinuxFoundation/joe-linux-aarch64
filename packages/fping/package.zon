.{
    .name = "fping",
    .version = "5.5",
    .release = 2,
    .description = "Sends ICMP echo requests to many hosts at once",
    .license = "BSD-4.3TAHOE",
    .sources = .{
        // Checked against David Schweikert's signature (fping-5.5.tar.gz.asc,
        // key 8D1E89B8FBA920A5A609F2615A11A22BC5A1F734).
        .{ .url = "https://github.com/schweikert/fping/releases/download/v5.5/fping-5.5.tar.gz", .sha256 = "15c4e32b6c55ff105bafe03e8c91c7ca1b2eda31bf9a7127326bb87887ee18fe" },
    },
    // Not set-uid: run by an ordinary user, fping uses unprivileged ICMP
    // ("ping") sockets if net.ipv4.ping_group_range includes the user’s group.
    // On joe Linux systemd sets this range for all groups. On ARM the
    // administrator can set it in sysctl.d. Root uses raw sockets.
    .depends = .{ "bionic", "iana-etc" },
}

joe Linux: <sched.h> gives programs the kernel's CLONE_ and SCHED_ constants but not
struct clone_args, whose member names collide with programs' macros, as glibc's does.

diff --git i/libc/include/bits/linux_sched_constants.h w/libc/include/bits/linux_sched_constants.h
new file mode 100644
index 0000000..a937bc0
--- /dev/null
+++ w/libc/include/bits/linux_sched_constants.h
@@ -0,0 +1,86 @@

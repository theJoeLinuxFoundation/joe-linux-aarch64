.{
    .name = "joe-base",
    .version = "0.1",
    .release = 4,
    .description = "Everything a minimal joe Linux ARM system consists of",
    .license = "MIT",
    .depends = .{
        "joe-filesystem",
        "joe-release",
        "linux",
        "systemd-boot",
        "bionic",
        "llvm-runtimes",
        "tzdata",
        "dynamod",
        "eudev",
        "dave",
        "bash",
        "coreutils",
        "util-linux",
        "linux-pam",
        "shadow",
        "kmod",
        "iproute2",
        "dhcpcd",
        "procps-ng",
        "iana-etc",
        "findutils",
        "grep",
        "sed",
        "gawk",
        "less",
        "gzip",
        "xz",
        "zstd",
        "bzip2",
        "tar",
        "file",
        "diffutils",
        "btrfs-progs",
        // What a person at a server's console expects to find: becoming root
        // (doas, which also answers to sudo at a prompt), an editor, a way in
        // from another machine, the certificates TLS needs, and the tools for
        // the other file systems a disk may carry.
        "opendoas",
        "nano",
        "vim",
        "openssh",
        "psmisc",
        "inetutils",
        "traceroute",
        "dosfstools",
        "e2fsprogs",
        "make-ca",
    },
}

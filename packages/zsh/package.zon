.{
    .name = "zsh",
    .version = "5.9.2",
    .release = 1,
    .description = "Z shell, an interactive shell with programmable completion and a bash-like scripting language",
    .license = "MIT-Modern-Variant",
    .sources = .{
        .{ .url = "https://www.zsh.org/pub/zsh-5.9.2.tar.xz", .sha256 = "36fa734374b44783582cec09bcd67822e2f992c779ec1624ab5596df078d2f81" },
    },
    // libcap for the zsh/cap module, gdbm for zsh/db/gdbm, pcre2 for
    // zsh/pcre, ncurses for the line editor and zsh/curses.
    .depends = .{ "bionic", "ncurses", "libcap", "gdbm", "pcre2" },
}

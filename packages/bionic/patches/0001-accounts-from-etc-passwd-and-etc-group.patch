+// Fills pw from a line's fields. Returns 0, or ERANGE if buf is too small.
+int to_passwd(const PasswdFields& f, uid_t uid, gid_t gid, passwd* pw, char* buf, size_t len) {
+  Arena a(buf, len);
+  pw->pw_name = a.copy(f.start[0], f.stop[0]);
+  pw->pw_passwd = a.copy(f.start[1], f.stop[1]);
+#ifdef __LP64__
+  pw->pw_gecos = a.copy(f.start[4], f.stop[4]);
+#endif
+  pw->pw_dir = a.copy(f.start[5], f.stop[5]);
+  pw->pw_shell = a.copy(f.start[6], f.stop[6]);
+  pw->pw_uid = uid;
+  pw->pw_gid = gid;
+  if (!pw->pw_name || !pw->pw_passwd || !pw->pw_dir || !pw->pw_shell) return ERANGE;
+#ifdef __LP64__
+  if (!pw->pw_gecos) return ERANGE;

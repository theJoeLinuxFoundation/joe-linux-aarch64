.{
    .name = "tmux",
    .version = "3.8",
    .release = 1,
    .description = "Terminal multiplexer",
    .license = "ISC",
    .sources = .{
        .{ .url = "https://github.com/tmux/tmux/releases/download/3.8/tmux-3.8.tar.gz", .sha256 = "e79c699c7e949dccd0a4a125e17b8d1261e311b16979dbc8eb34542f3966d82e" },
    },
    // Socket activation and putting panes in their own cgroups need libsystemd.
    .depends = .{ "bionic", "libevent", "ncurses", "utf8proc" },
    // configure insists on a yacc even though cmd-parse.c is shipped.
    .build_depends = .{ "pkgconf", "bison" },
}

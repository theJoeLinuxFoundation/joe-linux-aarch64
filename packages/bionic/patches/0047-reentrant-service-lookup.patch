+static struct servent* find_service(const char* name, const char* proto, struct servent* entry) {
+  const char* cursor = NULL;
+  while (next_service(&cursor, entry) != NULL) {
+    if (proto != NULL && strcmp(entry->s_proto, proto) != 0) continue;
+    if (strcmp(entry->s_name, name) == 0) return entry;
+    for (char** alias = entry->s_aliases; *alias != NULL; ++alias) {
+      if (strcmp(*alias, name) == 0) return entry;
+    }
+  }
+  return NULL;

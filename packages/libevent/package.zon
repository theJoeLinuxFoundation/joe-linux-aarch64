.{
    .name = "libevent",
    .version = "2.1.13",
    .release = 1,
    .description = "Asynchronous event notification library",
    .license = "BSD-3-Clause",
    .sources = .{
        .{ .url = "https://github.com/libevent/libevent/releases/download/release-2.1.13-stable/libevent-2.1.13-stable.tar.gz", .sha256 = "f7e9383b8c0baa81b687e5b5eecc01beefaf1b19b64151d95ed61647fe7a315c" },
    },
    // libevent_openssl links OpenSSL. event_rpcgen.py is a Python script,
    // but only a development helper, so Python is not a dependency.
    .depends = .{ "bionic", "openssl" },
    .build_depends = .{"pkgconf"},
}

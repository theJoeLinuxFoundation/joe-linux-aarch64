joe Linux: make the resolver option limits public beside the resolver state.
Socat uses them for its DNS timeout, retry and search threshold options.

diff --git a/libc/dns/include/resolv_private.h b/libc/dns/include/resolv_private.h
index cb91f42..4dfc77b 100644
--- a/libc/dns/include/resolv_private.h
+++ b/libc/dns/include/resolv_private.h
@@ -126,9 +126,6 @@ struct res_sym {
 #define	LOCALDOMAINPARTS	2	/* min levels in name that is "local" */
 
 #define	RES_TIMEOUT		5	/* min. seconds between retries */
-#define	RES_MAXNDOTS		15	/* should reflect bit field size */
-#define	RES_MAXRETRANS		30	/* only for resolv.conf/RES_OPTIONS */
-#define	RES_MAXRETRY		5	/* only for resolv.conf/RES_OPTIONS */
 #define	RES_DFLRETRY		2	/* Default #/tries. */
 #define	RES_MAXTIME		65535	/* Infinity, in milliseconds. */
 
diff --git a/libc/include/resolv.h b/libc/include/resolv.h
index d9c0a7d..22341da 100644
--- a/libc/include/resolv.h
+++ b/libc/include/resolv.h
@@ -50,6 +50,10 @@ __BEGIN_DECLS
 #define MAXDNSRCH 6 /* max # domains in search path */
 #define MAXRESOLVSORT 10 /* number of net to sort on */
 
+#define	RES_MAXNDOTS		15	/* should reflect bit field size */
+#define	RES_MAXRETRANS		30	/* only for resolv.conf/RES_OPTIONS */
+#define	RES_MAXRETRY		5	/* only for resolv.conf/RES_OPTIONS */
+
 typedef enum { res_goahead, res_nextns, res_modified, res_done, res_error } res_sendhookact;
 
 typedef res_sendhookact (*res_send_qhook)(struct sockaddr* _Nonnull const* _Nonnull, const u_char* _Nonnull* _Nonnull, int* _Nonnull, u_char* _Nonnull, int, int* _Nonnull);

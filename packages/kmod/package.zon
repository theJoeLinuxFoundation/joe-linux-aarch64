.{
    .name = "kmod",
    .version = "34.3",
    .release = 3,
    .description = "Tools and library for loading and managing kernel modules",
    .license = "LGPL-2.1-or-later AND GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://www.kernel.org/pub/linux/utils/kernel/kmod/kmod-34.3.tar.xz", .sha256 = "985554de49c21a58abd68c6cda2251384e1e5bb08b3b14c7f02b51f4c90c2958" },
    },
    .depends = .{ "bionic", "zlib", "xz", "zstd" },
    .build_depends = .{ "meson", "ninja", "pkgconf" },
    // The kernel runs modprobe (this program) to load modules on demand, and
    // passes no authority on.
    .operations = .{
        .{ .programs = .{ "usr/bin/kmod" }, .allow = .{"all"} },
    },
}

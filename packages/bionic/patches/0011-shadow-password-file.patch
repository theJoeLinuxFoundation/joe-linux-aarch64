+ * and/or sell copies of the Software, and to permit persons to whom the
+ * Software is furnished to do so, subject to the following conditions:
+ *
+ * The above copyright notice and this permission notice shall be included in
+ * all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+ * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+
+// joe Linux: <shadow.h>, which Android's bionic does not have. The entries
+// of /etc/shadow are name:hash:lastchange:min:max:warn:inactive:expire:flag;
+// an empty number is -1 (and an empty flag ~0), as glibc and musl read
+// them. The non-reentrant functions share one static buffer, as glibc's do;
+// lckpwdf() is glibc's lock on /etc/.pwd.lock, waiting at most 15 seconds.
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <shadow.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "private/ErrnoRestorer.h"
+
+static const char kLockFile[] = "/etc/.pwd.lock";
+
+// Parses a number field [s, e): -1 if empty, false if not a number.
+static bool number(const char* s, const char* e, long* out) {
+  if (s == e) {
+    *out = -1;
+    return true;
+  }
+  long v = 0;
+  for (const char* p = s; p < e; ++p) {
+    if (*p < '0' || *p > '9') return false;
+    if (v > (LONG_MAX - (*p - '0')) / 10) return false;
+    v = v * 10 + (*p - '0');
+  }
+  *out = v;
+  return true;
+}
+
+int sgetspent_r(const char* line, struct spwd* sp, char* buf, size_t size, struct spwd** result) {
+  *result = nullptr;
+  size_t len = strcspn(line, "\n");
+  if (len + 1 > size) return ERANGE;
+  memcpy(buf, line, len);
+  buf[len] = '\0';
+
+  // Nine fields; a line that ends after the eighth is accepted, as glibc
+  // accepts it.
+  char* f[9] = {};
+  int n = 0;
+  char* p = buf;
+  f[n++] = p;
+  for (; *p != '\0'; ++p) {
+    if (*p == ':') {
+      if (n == 9) return EINVAL;
+      *p = '\0';
+      f[n++] = p + 1;
+    }
+  }
+  if (n < 8 || f[0][0] == '\0') return EINVAL;
+
+  long v[6];
+  for (int i = 0; i < 6; ++i) {
+    if (!number(f[i + 2], f[i + 2] + strlen(f[i + 2]), &v[i])) return EINVAL;
+  }
+  long flag = -1;
+  if (n == 9 && !number(f[8], f[8] + strlen(f[8]), &flag)) return EINVAL;
+
+  sp->sp_namp = f[0];
+  sp->sp_pwdp = f[1];
+  sp->sp_lstchg = v[0];
+  sp->sp_min = v[1];
+  sp->sp_max = v[2];
+  sp->sp_warn = v[3];
+  sp->sp_inact = v[4];
+  sp->sp_expire = v[5];
+  sp->sp_flag = static_cast<unsigned long>(flag);
+  *result = sp;
+  return 0;
+}
+
+int fgetspent_r(FILE* fp, struct spwd* sp, char* buf, size_t size, struct spwd** result) {
+  *result = nullptr;
+  char* line = nullptr;
+  size_t capacity = 0;
+  int error = ENOENT;
+  for (;;) {
+    ssize_t n = getline(&line, &capacity, fp);
+    if (n == -1) {
+      error = ferror(fp) ? errno : ENOENT;
+      break;
+    }
+    if (line[0] == '#' || line[0] == '\n' || line[0] == '+' || line[0] == '-') continue;
+    error = sgetspent_r(line, sp, buf, size, result);
+    if (error != EINVAL) break;  // Skip malformed lines.
+  }
+  free(line);
+  return error;
+}
+
+int getspnam_r(const char* name, struct spwd* sp, char* buf, size_t size, struct spwd** result) {
+  *result = nullptr;
+  if (strchr(name, ':') != nullptr || strchr(name, '\n') != nullptr || *name == '\0') return ENOENT;
+  FILE* fp = fopen(SHADOW, "re");
+  if (fp == nullptr) return errno;
+  int error;
+  while ((error = fgetspent_r(fp, sp, buf, size, result)) == 0) {
+    if (strcmp(sp->sp_namp, name) == 0) break;
+    *result = nullptr;
+  }
+  fclose(fp);
+  // Not found is not an error for the _r function: *result is null.
+  return error == ENOENT ? 0 : error;
+}
+
+// The state of getspent() and of the non-reentrant functions.
+static FILE* g_spent_file;
+static struct spwd g_spwd;
+static char g_spwd_buf[4096];
+
+void setspent() {
+  if (g_spent_file != nullptr) rewind(g_spent_file);
+}
+
+void endspent() {
+  if (g_spent_file != nullptr) {
+    fclose(g_spent_file);
+    g_spent_file = nullptr;
+  }
+}
+
+int getspent_r(struct spwd* sp, char* buf, size_t size, struct spwd** result) {
+  *result = nullptr;
+  if (g_spent_file == nullptr && (g_spent_file = fopen(SHADOW, "re")) == nullptr) return errno;
+  return fgetspent_r(g_spent_file, sp, buf, size, result);
+}
+
+struct spwd* getspent() {
+  struct spwd* result;
+  int error = getspent_r(&g_spwd, g_spwd_buf, sizeof(g_spwd_buf), &result);
+  if (error != 0 && error != ENOENT) errno = error;
+  return result;
+}
+
+struct spwd* getspnam(const char* name) {
+  struct spwd* result;
+  int saved = errno;
+  int error = getspnam_r(name, &g_spwd, g_spwd_buf, sizeof(g_spwd_buf), &result);
+  // As getpwnam(): no entry leaves errno as it was.
+  errno = (error != 0) ? error : saved;
+  return result;
+}
+
+struct spwd* sgetspent(const char* line) {
+  struct spwd* result;
+  int error = sgetspent_r(line, &g_spwd, g_spwd_buf, sizeof(g_spwd_buf), &result);
+  if (error != 0) errno = error;
+  return result;
+}
+
+struct spwd* fgetspent(FILE* fp) {
+  struct spwd* result;
+  int error = fgetspent_r(fp, &g_spwd, g_spwd_buf, sizeof(g_spwd_buf), &result);
+  if (error != 0 && error != ENOENT) errno = error;
+  return result;
+}
+
+// Empty numbers (-1) are written as empty fields.
+static int put_number(FILE* fp, long v, bool last) {
+  if (v == -1) return fputs(last ? "" : ":", fp) < 0 ? -1 : 0;
+  return fprintf(fp, last ? "%ld" : "%ld:", v) < 0 ? -1 : 0;
+}
+
+int putspent(const struct spwd* sp, FILE* fp) {
+  if (sp->sp_namp == nullptr || strchr(sp->sp_namp, ':') != nullptr) {
+    errno = EINVAL;
+    return -1;
+  }
+  flockfile(fp);
+  int rc = 0;
+  if (fprintf(fp, "%s:%s:", sp->sp_namp, sp->sp_pwdp ? sp->sp_pwdp : "") < 0) rc = -1;
+  const long v[] = {sp->sp_lstchg, sp->sp_min, sp->sp_max, sp->sp_warn, sp->sp_inact, sp->sp_expire};
+  for (long x : v) {
+    if (rc == 0) rc = put_number(fp, x, false);
+  }
+  if (rc == 0 && sp->sp_flag != ~0UL && fprintf(fp, "%lu", sp->sp_flag) < 0) rc = -1;
+  if (rc == 0 && fputc('\n', fp) == EOF) rc = -1;
+  funlockfile(fp);
+  return rc;
+}
+
+static int g_lock_fd = -1;
+
+int lckpwdf() {
+  if (g_lock_fd != -1) return -1;
+  int fd = open(kLockFile, O_WRONLY | O_CREAT | O_CLOEXEC, 0600);
+  if (fd == -1) return -1;
+  struct flock lock = {};
+  lock.l_type = F_WRLCK;
+  lock.l_whence = SEEK_SET;
+  for (int tries = 0; tries < 15; ++tries) {
+    if (fcntl(fd, F_SETLK, &lock) == 0) {
+      g_lock_fd = fd;
+      return 0;
+    }
+    if (errno != EACCES && errno != EAGAIN) break;
+    sleep(1);
+  }
+  ErrnoRestorer errno_restorer;
+  close(fd);
+  return -1;
+}
+
+int ulckpwdf() {
+  if (g_lock_fd == -1) return -1;
+  int rc = close(g_lock_fd);
+  g_lock_fd = -1;
+  return rc;
+}

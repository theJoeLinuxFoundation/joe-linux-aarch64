diff --git i/libc/bionic/utmp.cpp w/libc/bionic/utmp.cpp
index aa00cd5..368f8ad 100644
--- i/libc/bionic/utmp.cpp
+++ w/libc/bionic/utmp.cpp
@@ -29,6 +29,9 @@
 #include <utmp.h>
 
 #include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <utmpx.h>
 
 void endutent() {}
 
@@ -46,3 +49,38 @@ int utmpname(const char*) {
   errno = ENOTSUP;
   return -1;
 }
+
+// joe Linux: updwtmp(3) and updwtmpx(3) append a record to a login records
+// file such as /var/log/wtmp, as glibc's do, and do nothing where the file
+// does not exist (Android keeps none). agetty records logins with
+// updwtmpx(), and util-linux builds agetty only where it exists.
+void updwtmp(const char* path, const utmp* entry) {
+  int fd = open(path, O_WRONLY | O_APPEND | O_CLOEXEC);
+  if (fd == -1) return;
+  // Locked while it is written, and cut back to its size before if the
+  // record could not be written whole, as glibc does.
+  struct flock lock = {};
+  lock.l_type = F_WRLCK;
+  lock.l_whence = SEEK_SET;
+  bool locked = TEMP_FAILURE_RETRY(fcntl(fd, F_SETLKW, &lock)) == 0;
+  off_t size = lseek(fd, 0, SEEK_END);
+  if (size != -1 &&
+      TEMP_FAILURE_RETRY(write(fd, entry, sizeof(*entry))) != static_cast<ssize_t>(sizeof(*entry))) {
+    TEMP_FAILURE_RETRY(ftruncate(fd, size));
+  }
+  if (locked) {
+    lock.l_type = F_UNLCK;
+    fcntl(fd, F_SETLK, &lock);
+  }
+  close(fd);
+}
+
+// (<utmpx.h> declares these only for _GNU_SOURCE.)
+extern "C" int utmpxname(const char* path) {
+  return utmpname(path);
+}
+
+extern "C" void updwtmpx(const char* path, const utmpx* entry) {
+  static_assert(sizeof(utmpx) == sizeof(utmp), "struct utmpx is struct utmp");
+  updwtmp(path, reinterpret_cast<const utmp*>(entry));
+}

joe Linux: provide getdtablesize for lsof on LP64. Preserve the existing
32-bit implementation and symbol version. Clamp limits too large for an int.

diff --git a/libc/bionic/sysconf.cpp b/libc/bionic/sysconf.cpp
index 03822ed..f5bd15f 100644
--- a/libc/bionic/sysconf.cpp
+++ b/libc/bionic/sysconf.cpp
@@ -148,6 +148,15 @@ static long __sysconf_rlimit(int resource) {
   return rl.rlim_cur;
 }
 
+#if defined(__LP64__)
+// The 32-bit compatibility implementation lives in ndk_cruft.cpp.
+int getdtablesize() {
+  struct rlimit limit;
+  if (getrlimit(RLIMIT_NOFILE, &limit) == -1) return -1;
+  return limit.rlim_cur > INT_MAX ? INT_MAX : static_cast<int>(limit.rlim_cur);
+}
+#endif
+
 long sysconf(int name) {
   switch (name) {
     //

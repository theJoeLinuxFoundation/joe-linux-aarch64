joe Linux: provide wait3 on LP64 using wait4, as bionic already does in
the 32-bit compatibility code. Dash uses it to wait for any child.

diff --git a/libc/bionic/wait.cpp b/libc/bionic/wait.cpp
index 3e59f51..eef284c 100644
--- a/libc/bionic/wait.cpp
+++ b/libc/bionic/wait.cpp
@@ -43,3 +43,10 @@ int waitid(idtype_t which, id_t id, siginfo_t* info, int options) {
   // The system call takes an optional struct rusage that we don't need.
   return __waitid(which, id, info, options, nullptr);
 }
+
+#if defined(__LP64__)
+// The 32-bit compatibility implementation lives in ndk_cruft.cpp.
+pid_t wait3(int* status, int options, struct rusage* usage) {
+  return wait4(-1, status, options, usage);
+}
+#endif
diff --git a/libc/include/sys/wait.h b/libc/include/sys/wait.h
index 632aa43..2a8f1b9 100644
--- a/libc/include/sys/wait.h
+++ b/libc/include/sys/wait.h
@@ -40,6 +40,7 @@ __BEGIN_DECLS
 
 pid_t wait(int* _Nullable __status);
 pid_t waitpid(pid_t __pid, int* _Nullable __status, int __options);
+pid_t wait3(int* _Nullable __status, int __options, struct rusage* _Nullable __rusage);
 pid_t wait4(pid_t __pid, int* _Nullable __status, int __options, struct rusage* _Nullable __rusage);
 
 /* Posix states that idtype_t should be an enumeration type, but

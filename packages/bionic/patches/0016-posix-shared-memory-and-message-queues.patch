+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+ * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+
+// joe Linux: POSIX shared memory and message queues, which glibc and musl
+// have and Android, which has its own shared memory and no use for message
+// queues, does not.
+//
+// A shared memory object is a file in /dev/shm, a tmpfs, as in glibc and
+// musl. A message queue is the kernel's; its names here begin with a slash,
+// the kernel's do not.
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <mqueue.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include "private/ErrnoRestorer.h"
+
+extern "C" int __mq_open(const char* name, int flags, mode_t mode, mq_attr* attr);
+extern "C" int __mq_unlink(const char* name);
+extern "C" int __mq_notify(mqd_t mq, const sigevent* event);
+extern "C" int __mq_getsetattr(mqd_t mq, const mq_attr* new_attr, mq_attr* old_attr);
+
+static constexpr char kShmDir[] = "/dev/shm/";
+using ShmPath = char[sizeof(kShmDir) + NAME_MAX];
+
+// The file of the shared memory object `name`: leading slashes are dropped,
+// and what is left must be a file name, as glibc requires.
+static bool shm_path(const char* name, ShmPath& path) {
+  while (*name == '/') name++;
+  size_t length = strnlen(name, NAME_MAX + 1);
+  if (length > NAME_MAX) {
+    errno = ENAMETOOLONG;
+    return false;
+  }
+  if (length == 0 || strchr(name, '/') != nullptr || strcmp(name, ".") == 0 ||
+      strcmp(name, "..") == 0) {
+    errno = EINVAL;
+    return false;
+  }
+  memcpy(path, kShmDir, sizeof(kShmDir) - 1);
+  memcpy(path + sizeof(kShmDir) - 1, name, length + 1);
+  return true;
+}
+
+int shm_open(const char* name, int flags, mode_t mode) {
+  ShmPath path;
+  if (!shm_path(name, path)) return -1;
+  return open(path, flags | O_NOFOLLOW | O_CLOEXEC, mode);
+}
+
+int shm_unlink(const char* name) {
+  ShmPath path;
+  if (!shm_path(name, path)) return -1;
+  return unlink(path);
+}
+
+mqd_t mq_open(const char* name, int flags, ...) {
+  if (name[0] != '/') {
+    errno = EINVAL;
+    return -1;
+  }
+  mode_t mode = 0;
+  mq_attr* attr = nullptr;
+  if ((flags & O_CREAT) != 0) {
+    va_list args;
+    va_start(args, flags);
+    mode = va_arg(args, mode_t);
+    attr = va_arg(args, mq_attr*);
+    va_end(args);
+  }
+  return __mq_open(name + 1, flags, mode, attr);
+}
+
+int mq_close(mqd_t mq) {
+  return close(mq);
+}
+
+int mq_unlink(const char* name) {
+  if (name[0] != '/') {
+    errno = EINVAL;
+    return -1;
+  }
+  int result = __mq_unlink(name + 1);
+  // POSIX's error for a queue the caller may not remove, as in glibc.
+  if (result == -1 && errno == EPERM) errno = EACCES;
+  return result;
+}
+
+int mq_getattr(mqd_t mq, mq_attr* attr) {
+  return __mq_getsetattr(mq, nullptr, attr);
+}
+
+int mq_setattr(mqd_t mq, const mq_attr* new_attr, mq_attr* old_attr) {
+  return __mq_getsetattr(mq, new_attr, old_attr);
+}
+
+int mq_send(mqd_t mq, const char* msg, size_t length, unsigned int priority) {
+  return mq_timedsend(mq, msg, length, priority, nullptr);
+}
+
+ssize_t mq_receive(mqd_t mq, char* msg, size_t length, unsigned int* priority) {
+  return mq_timedreceive(mq, msg, length, priority, nullptr);
+}
+
+// SIGEV_THREAD: the kernel cannot start a thread, so, as glibc and musl do,
+// it is given a netlink socket instead, and sends a message on it when the
+// queue is no longer empty; a thread of ours waits for that message and
+// calls the function. The thread is started after the kernel has accepted
+// the socket, so that a failure needs no thread to be stopped.
+struct MqNotification {
+  int socket;
+  void (*function)(sigval);
+  sigval value;
+};
+
+static void* mq_notification_thread(void* arg) {
+  MqNotification n = *static_cast<MqNotification*>(arg);
+  free(arg);
+  unsigned char cookie[NOTIFY_COOKIE_LEN];
+  ssize_t received;
+  do {
+    received = recv(n.socket, cookie, sizeof(cookie), MSG_NOSIGNAL | MSG_WAITALL);
+  } while (received == -1 && errno == EINTR);
+  close(n.socket);
+  // The kernel also writes when the notification is removed (NOTIFY_REMOVED).
+  if (received == sizeof(cookie) && cookie[NOTIFY_COOKIE_LEN - 1] == NOTIFY_WOKENUP) {
+    n.function(n.value);
+  }
+  return nullptr;
+}
+
+int mq_notify(mqd_t mq, const sigevent* event) {
+  if (event == nullptr || event->sigev_notify != SIGEV_THREAD) return __mq_notify(mq, event);
+  if (event->sigev_notify_function == nullptr) {
+    errno = EINVAL;
+    return -1;
+  }
+
+  int s = socket(AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, 0);
+  if (s == -1) return -1;
+  // What the kernel sends back on the socket; ours is all zeros.
+  static const unsigned char cookie[NOTIFY_COOKIE_LEN] = {};
+  sigevent kernel_event = {};
+  kernel_event.sigev_notify = SIGEV_THREAD;
+  kernel_event.sigev_signo = s;
+  kernel_event.sigev_value.sival_ptr = const_cast<unsigned char*>(cookie);
+  if (__mq_notify(mq, &kernel_event) == -1) {
+    ErrnoRestorer errno_restorer;
+    close(s);
+    return -1;
+  }
+
+  pthread_attr_t attr;
+  if (event->sigev_notify_attributes == nullptr) {
+    pthread_attr_init(&attr);
+  } else {
+    attr = *static_cast<pthread_attr_t*>(event->sigev_notify_attributes);
+  }
+  pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+
+  MqNotification* n = static_cast<MqNotification*>(malloc(sizeof(MqNotification)));
+  int error = ENOMEM;
+  if (n != nullptr) {
+    *n = {s, event->sigev_notify_function, event->sigev_value};
+    pthread_t thread;
+    error = pthread_create(&thread, &attr, mq_notification_thread, n);
+  }
+  if (error != 0) {
+    // Nothing would wait for the kernel's message: take the notification back.
+    __mq_notify(mq, nullptr);
+    close(s);
+    free(n);
+    errno = (error == EAGAIN) ? EAGAIN : ENOMEM;
+    return -1;
+  }
+  return 0;
+}

.{
    .name = "ninja",
    .version = "1.13.2",
    .release = 2,
    .description = "Small build system with a focus on speed",
    .license = "Apache-2.0",
    .sources = .{
        .{ .url = "https://github.com/ninja-build/ninja/archive/v1.13.2/ninja-1.13.2.tar.gz", .sha256 = "974d6b2f4eeefa25625d34da3cb36bdcebe7fbce40f4c16ac0835fd1c0cbae17" },
    },
    // ninja also needs libstdc++ and libgcc_s (gcc) at run time. Not listed: ninja
    // has to be built before pkgconf, which is long before gcc.
    .depends = .{ "bionic", "llvm-runtimes" },
    .build_depends = .{"python"},
}

+
+#pragma once
+
+/**
+ * @file shadow.h
+ * @brief The shadow password file, /etc/shadow.
+ *
+ * joe Linux: not in Android's bionic, which has no password file. The
+ * interface is glibc's (and musl's): accounts' password hashes and ageing
+ * information, readable only by root, beside the world-readable
+ * /etc/passwd.
+ */
+
+#include <sys/cdefs.h>
+#include <stddef.h>
+#include <stdio.h>
+
+__BEGIN_DECLS
+
+/** The shadow password file. */
+#define SHADOW "/etc/shadow"
+
+/**
+ * An entry of the shadow password file. The numbers are days since
+ * 1970-01-01, or -1 where the field is empty.
+ */
+struct spwd {
+  char* _Nullable sp_namp;
+  char* _Nullable sp_pwdp;
+  long int sp_lstchg;
+  long int sp_min;
+  long int sp_max;
+  long int sp_warn;
+  long int sp_inact;
+  long int sp_expire;
+  unsigned long int sp_flag;
+};
+
+void setspent(void);
+void endspent(void);
+struct spwd* _Nullable getspent(void);
+struct spwd* _Nullable getspnam(const char* _Nonnull __name);
+struct spwd* _Nullable sgetspent(const char* _Nonnull __line);
+struct spwd* _Nullable fgetspent(FILE* _Nonnull __fp);
+int putspent(const struct spwd* _Nonnull __entry, FILE* _Nonnull __fp);
+
+int getspent_r(struct spwd* _Nonnull __entry, char* _Nonnull __buf, size_t __size, struct spwd* _Nullable * _Nonnull __result);
+int getspnam_r(const char* _Nonnull __name, struct spwd* _Nonnull __entry, char* _Nonnull __buf, size_t __size, struct spwd* _Nullable * _Nonnull __result);
+int sgetspent_r(const char* _Nonnull __line, struct spwd* _Nonnull __entry, char* _Nonnull __buf, size_t __size, struct spwd* _Nullable * _Nonnull __result);
+int fgetspent_r(FILE* _Nonnull __fp, struct spwd* _Nonnull __entry, char* _Nonnull __buf, size_t __size, struct spwd* _Nullable * _Nonnull __result);
+
+/** Takes the lock tools hold while they rewrite /etc/passwd and /etc/shadow. */
+int lckpwdf(void);
+/** Releases the lock lckpwdf() took. */
+int ulckpwdf(void);
+
+__END_DECLS

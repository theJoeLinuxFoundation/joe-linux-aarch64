.{
    .name = "curl",
    .version = "8.23.0",
    .release = 1,
    .description = "Command line tool and library for transferring data with URLs",
    .license = "curl",
    .sources = .{
        .{ .url = "https://curl.se/download/curl-8.23.0.tar.xz", .sha256 = "8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5" },
    },
    .depends = .{ "bionic", "openssl", "zlib", "zstd", "libpsl", "nghttp2", "libidn2", "make-ca" },
    .build_depends = .{ "pkgconf", "perl" },
}

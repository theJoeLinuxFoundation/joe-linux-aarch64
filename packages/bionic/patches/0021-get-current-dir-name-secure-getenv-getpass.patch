+// joe Linux: get_current_dir_name(3), secure_getenv(3) and getpass(3),
+// which glibc and musl have and bionic lacks; kmod, e2fsprogs and iproute2
+// use them.
+
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/auxv.h>
+#include <sys/stat.h>
+#include <termios.h>
+#include <unistd.h>
+
+char* get_current_dir_name() {
+  // $PWD, which keeps the symbolic links the shell followed, when it is
+  // the current directory; otherwise getcwd()'s answer.
+  const char* pwd = getenv("PWD");
+  struct stat dot, here;
+  if (pwd != nullptr && pwd[0] == '/' && stat(".", &dot) == 0 && stat(pwd, &here) == 0 &&
+      dot.st_dev == here.st_dev && dot.st_ino == here.st_ino) {
+    return strdup(pwd);
+  }
+  return getcwd(nullptr, 0);
+}
+
+char* secure_getenv(const char* name) {
+  return getauxval(AT_SECURE) ? nullptr : getenv(name);
+}
+
+char* getpass(const char* prompt) {
+  static char password[128];
+  int in = open("/dev/tty", O_RDWR | O_NOCTTY | O_CLOEXEC);
+  int out = in;
+  bool own = in != -1;
+  if (!own) {  // No terminal: standard input and standard error, as glibc.
+    in = STDIN_FILENO;
+    out = STDERR_FILENO;
+  }
+  termios saved;
+  bool restore = tcgetattr(in, &saved) == 0;
+  if (restore) {
+    termios quiet = saved;
+    quiet.c_lflag &= ~(ECHO | ISIG);
+    quiet.c_lflag |= ICANON;
+    tcsetattr(in, TCSAFLUSH, &quiet);
+  }
+  dprintf(out, "%s", prompt);
+  ssize_t n = read(in, password, sizeof(password) - 1);
+  if (n >= 0) {
+    if (n > 0 && password[n - 1] == '\n') --n;
+    password[n] = '\0';
+  }
+  if (restore) {
+    tcsetattr(in, TCSAFLUSH, &saved);
+    dprintf(out, "\n");
+  }
+  if (own) close(in);
+  return n < 0 ? nullptr : password;
+}

.{
    .name = "socat",
    .version = "1.8.1.3",
    .release = 1,
    .description = "Relays data between two bidirectional byte streams of almost any kind",
    .license = "GPL-2.0-only WITH openvpn-openssl-exception",
    .sources = .{
        // Its SHA-256 is in upstream's download.sha256sum.
        .{ .url = "http://www.dest-unreach.org/socat/download/socat-1.8.1.3.tar.gz", .sha256 = "06602ffd591e98c75b3dc1d66f0f19136cc666b0b2d95caad987d6ab2cb28097" },
    },
    // bash: socat-chain.sh, socat-mux.sh and socat-broker.sh.
    .depends = .{ "bionic", "openssl", "readline", "bash", "libbsd" },
}

.{
    .name = "cmake",
    .version = "4.4.5",
    .release = 2,
    .description = "Cross-platform build system generator, with ctest and cpack",
    .license = "BSD-3-Clause",
    .sources = .{
        .{ .url = "https://cmake.org/files/v4.4/cmake-4.4.5.tar.gz", .sha256 = "a0c54c88abb8078dd8eccadb717fc6bb194bf18e7d44c86309910288886e04e2" },
    },
    // Its own copies of curl, libarchive, libuv and the rest: cmake is a
    // build tool here, and those libraries are not part of the base system.
    .depends = .{ "bionic", "llvm-runtimes", "ncurses" },
}

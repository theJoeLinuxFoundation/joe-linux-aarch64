.{
    .name = "memcached",
    .version = "1.6.45",
    .release = 1,
    .description = "High-performance, distributed memory object caching system",
    .license = "BSD-3-Clause",
    .sources = .{
        // Checked against the SHA-1 on memcached.org's download page.
        .{ .url = "https://www.memcached.org/files/memcached-1.6.45.tar.gz", .sha256 = "d362c64e6d8d5287153501eabf7c85b4a761432fbf53f5d7b085d0bb1653c1dd" },
    },
    // perl runs memcached-tool.
    .depends = .{ "bionic", "libevent", "openssl", "libseccomp", "perl" },
    .build_depends = .{"pkgconf"},
}

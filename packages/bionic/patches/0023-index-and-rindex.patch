+
+// joe Linux: index(3) and rindex(3), the old BSD names of strchr() and
+// strrchr(), which glibc and musl keep and programs written for Linux still
+// call (iproute2's tc). On 32-bit Arm and x86, bionic already exports index()
+// for old NDK apps (ndk_cruft.cpp).
+
+#include <string.h>
+#include <strings.h>
+
+#if defined(__LP64__)
+char* index(const char* s, int ch) {
+  return const_cast<char*>(strchr(s, ch));
+}
+#endif
+
+char* rindex(const char* s, int ch) {
+  return const_cast<char*>(strrchr(s, ch));
+}
diff --git i/libc/include/string.h w/libc/include/string.h
--- i/libc/include/string.h
+++ w/libc/include/string.h
@@ -37,9 +37,9 @@
 
 __BEGIN_DECLS
 
-#if defined(__USE_BSD) || defined(__USE_GNU)
+/* joe Linux: by default, as glibc's <string.h> includes <strings.h> (index,
+ * strcasecmp, ...) unless a strict standard is asked for. */
 #include <strings.h>
-#endif
 
 void* _Nullable memccpy(void* _Nonnull __dst, const void* _Nonnull __src, int __stop_char, size_t __n);
 void* _Nullable memchr(const void* _Nonnull __s, int __ch, size_t __n) __attribute_pure__;
diff --git i/libc/include/strings.h w/libc/include/strings.h
--- i/libc/include/strings.h
+++ w/libc/include/strings.h
@@ -105,6 +105,16 @@
   return __builtin_ffsll(__n);
 }
 
+/**
+ * index(3) is strchr() under its old BSD name (joe Linux: declared by
+ * default, as glibc's <strings.h> and <string.h> do, and as bionic declares
+ * its other BSD string functions).
+ */
+char* _Nullable index(const char* _Nonnull __s, int __ch) __attribute_pure__;
+
+/** rindex(3) is strrchr() under its old BSD name (joe Linux, as glibc). */
+char* _Nullable rindex(const char* _Nonnull __s, int __ch) __attribute_pure__;
+
 #if defined(__BIONIC_INCLUDE_FORTIFY_HEADERS)
 #include <bits/fortify/strings.h>
 #endif

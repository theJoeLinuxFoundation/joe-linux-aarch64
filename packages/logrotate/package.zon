.{
    .name = "logrotate",
    .version = "3.22.0",
    .release = 1,
    .description = "Rotates, compresses and removes log files",
    .license = "GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://github.com/logrotate/logrotate/releases/download/3.22.0/logrotate-3.22.0.tar.xz", .sha256 = "42b4080ee99c9fb6a7d12d8e787637d057a635194e25971997eebbe8d5e57618" },
    },
    // gzip compresses the rotated logs (the configuration's "compress").
    .depends = .{ "bionic", "popt", "acl", "gzip", "bash", "coreutils" },
    .build_depends = .{"pkgconf"},
}

+// joe Linux: strftime_z(3). bionic has NetBSD's timezone_t functions,
+// tzalloc() and localtime_rz() among them, but not this one; gnulib, finding
+// the others, then expects functions of its own that it does not build, and
+// GNU programs fail to link. bionic's struct tm carries its zone's name and
+// offset, which are all %Z and %z print, so the time zone is not needed.
+
+#include <time.h>
+
+size_t strftime_z(timezone_t, char* buf, size_t n, const char* fmt, const struct tm* tm) {
+  return strftime(buf, n, fmt, tm);
+}
diff --git i/libc/include/time.h w/libc/include/time.h
index b15ca75..1a8ed98 100644
--- i/libc/include/time.h
+++ w/libc/include/time.h
@@ -236,6 +236,16 @@ struct tm* _Nullable localtime_r(const time_t* _Nonnull __t, struct tm* _Nonnull
 struct tm* _Nullable localtime_rz(timezone_t _Nonnull __tz, const time_t* _Nonnull __t, struct tm* _Nonnull __tm) __INTRODUCED_IN(35);
 #endif
 
+/**
+ * strftime_z(3) is strftime() for a broken-down time made by localtime_rz()
+ * with the given timezone, as in NetBSD, whose timezone_t functions these
+ * are. bionic's `struct tm` carries its zone's name and offset, which are
+ * what %Z and %z print, so `tz` itself is not needed and may be null.
+ *
+ * joe Linux: not in Android's bionic.
+ */
+size_t strftime_z(timezone_t _Nullable __tz, char* _Nonnull __buf, size_t __n, const char* _Nonnull __fmt, const struct tm* _Nullable __tm) __strftimelike(4);
+
 /**
  * Inverse of localtime().
  */

.{
    .name = "keyutils",
    .version = "1.6.3",
    .release = 2,
    .description = "Tools and library for the kernel key management facility",
    .license = "GPL-2.0-or-later AND LGPL-2.1-or-later",
    .sources = .{
        .{ .url = "https://git.kernel.org/pub/scm/linux/kernel/git/dhowells/keyutils.git/snapshot/keyutils-1.6.3.tar.gz", .sha256 = "a61d5706136ae4c05bd48f86186bcfdbd88dd8bd5107e3e195c924cfc1b39bb4" },
    },
    .depends = .{"bionic"},
    // The kernel runs request-key itself, and passes no authority on.
    .operations = .{
        .{ .programs = .{ "usr/sbin/request-key" }, .allow = .{"all"} },
    },
}

+// joe Linux: ether_line(3), ether_ntohost(3) and ether_hostton(3), which
+// read /etc/ethers as glibc's do; inetutils' ifconfig uses them.
+
+#include <ctype.h>
+#include <netinet/ether.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int ether_line(const char* line, ether_addr* addr, char* hostname) {
+  const char* p = line;
+  while (isspace(static_cast<unsigned char>(*p))) ++p;
+  const char* a = p;
+  while (*p != '\0' && !isspace(static_cast<unsigned char>(*p)) && *p != '#') ++p;
+  char text[32];
+  size_t n = p - a;
+  if (n == 0 || n >= sizeof(text)) return -1;
+  memcpy(text, a, n);
+  text[n] = '\0';
+  if (ether_aton_r(text, addr) == nullptr) return -1;
+  while (*p != '\0' && isspace(static_cast<unsigned char>(*p))) ++p;
+  const char* h = p;
+  while (*p != '\0' && !isspace(static_cast<unsigned char>(*p)) && *p != '#') ++p;
+  if (p == h) return -1;
+  memcpy(hostname, h, p - h);
+  hostname[p - h] = '\0';
+  return 0;
+}
+
+namespace {
+
+// Calls match(addr, name) on each entry of /etc/ethers until it returns true.
+template <typename Match>
+int each_entry(Match match) {
+  FILE* fp = fopen("/etc/ethers", "re");
+  if (fp == nullptr) return -1;
+  char* line = nullptr;
+  size_t capacity = 0;
+  int result = -1;
+  while (getline(&line, &capacity, fp) != -1) {
+    ether_addr addr;
+    char name[1024];
+    if (strlen(line) >= sizeof(name)) continue;
+    if (ether_line(line, &addr, name) == 0 && match(addr, name)) {
+      result = 0;
+      break;
+    }
+  }
+  free(line);
+  fclose(fp);
+  return result;
+}
+
+}  // namespace
+
+int ether_ntohost(char* hostname, const ether_addr* addr) {
+  return each_entry([&](const ether_addr& a, const char* name) {
+    if (memcmp(&a, addr, sizeof(a)) != 0) return false;
+    strcpy(hostname, name);
+    return true;
+  });
+}
+
+int ether_hostton(const char* hostname, ether_addr* addr) {
+  return each_entry([&](const ether_addr& a, const char* name) {
+    if (strcmp(name, hostname) != 0) return false;
+    *addr = a;
+    return true;
+  });
+}

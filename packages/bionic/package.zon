        .{ .url = "git+https://android.googlesource.com/platform/external/arm-optimized-routines#498b3de1a06e8cd87b2f9d49d1d8a23ebba5cc5a", .file = "aosp-external-arm-optimized-routines-498b3de1a06e8cd87b2f9d49d1d8a23ebba5cc5a.tar", .sha256 = "d601d528688185b8c510ec5adb76d3cf991960670b8e26a8248c7b2ddd0b46dd" },

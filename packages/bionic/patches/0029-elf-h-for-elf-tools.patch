joe Linux: <elf.h> for tools that read other architectures' ELF files, as glibc's serves them:
the ELF32_ and ELF64_ symbol macros defined on their own, and the ARM and LoongArch relocations
the kernel's modpost uses.

diff --git i/libc/include/bits/elf_common.h w/libc/include/bits/elf_common.h
--- i/libc/include/bits/elf_common.h
+++ w/libc/include/bits/elf_common.h
@@ -1096,6 +1096,15 @@
 #define	R_ARM_GOTPC		25	/* Add PC-relative GOT table address. */
 #define	R_ARM_GOT32		26	/* Add PC-relative GOT offset. */
 #define	R_ARM_PLT32		27	/* Add PC-relative PLT offset. */
+/* joe Linux: the rest that glibc's <elf.h> has and the kernel's modpost uses. */
+#define	R_ARM_CALL		28
+#define	R_ARM_JUMP24		29
+#define	R_ARM_THM_JUMP24	30
+#define	R_ARM_MOVW_ABS_NC	43
+#define	R_ARM_MOVT_ABS		44
+#define	R_ARM_THM_MOVW_ABS_NC	47
+#define	R_ARM_THM_MOVT_ABS	48
+#define	R_ARM_THM_JUMP19	51
 #define	R_ARM_GNU_VTENTRY	100
 #define	R_ARM_GNU_VTINHERIT	101
 #define	R_ARM_RSBREL32		250
@@ -1105,6 +1114,11 @@
 #define	R_ARM_RPC24		254
 #define	R_ARM_RBASE		255
 
+/* joe Linux: LoongArch's, as glibc's <elf.h> has them (the kernel's modpost). */
+#define	R_LARCH_SUB32		55
+#define	R_LARCH_RELAX		100
+#define	R_LARCH_ALIGN		102
+
 /*	Name			Value	   Field	Calculation */
 #define	R_IA_64_NONE		0	/* None */
 #define	R_IA_64_IMM14		0x21	/* immediate14	S + A */
diff --git i/libc/include/elf.h w/libc/include/elf.h
--- i/libc/include/elf.h
+++ w/libc/include/elf.h
@@ -177,8 +177,23 @@
 
 /* http://www.sco.com/developers/gabi/latest/ch4.symtab.html */
 #define ELF_ST_INFO(b,t) (((b) << 4) + ((t) & 0xf))
-#define ELF32_ST_INFO(b,t) ELF_ST_INFO(b,t)
-#define ELF64_ST_INFO(b,t) ELF_ST_INFO(b,t)
+
+/*
+ * joe Linux: the ELF32_ and ELF64_ symbol macros on their own, as glibc's,
+ * not through the kernel's ELF_ST_BIND and ELF_ST_TYPE: a program that
+ * defines ELF_ST_TYPE as ELF64_ST_TYPE (the kernel's modpost) would make a
+ * loop of them.
+ */
+#undef ELF32_ST_BIND
+#undef ELF32_ST_TYPE
+#undef ELF64_ST_BIND
+#undef ELF64_ST_TYPE
+#define ELF32_ST_BIND(val) (((unsigned char) (val)) >> 4)
+#define ELF32_ST_TYPE(val) ((val) & 0xf)
+#define ELF32_ST_INFO(bind, type) (((bind) << 4) + ((type) & 0xf))
+#define ELF64_ST_BIND(val) ELF32_ST_BIND(val)
+#define ELF64_ST_TYPE(val) ELF32_ST_TYPE(val)
+#define ELF64_ST_INFO(bind, type) ELF32_ST_INFO((bind), (type))
 
 /* http://www.sco.com/developers/gabi/latest/ch4.sheader.html */
 #define GRP_MASKOS   0x0ff00000

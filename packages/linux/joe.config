# joe Linux ARM kernel configuration, applied on top of the kernel's own
# arm64 defconfig. Everything needed to mount the root file system is built
# in, because joe boots without an initramfs.
#
# defconfig also covers the boards and phones that Linux supports. Their
# platforms stay (a device tree machine with UEFI firmware boots this kernel
# too); what only a desktop or a phone uses is switched off below.

CONFIG_LOCALVERSION="-joe"
# CONFIG_LOCALVERSION_AUTO is not set

# The processor. 4 KiB pages: the page size every arm64 processor and
# hypervisor supports, and the only one programs built for another
# distribution can always be loaded with (an ELF segment aligned for 4 KiB
# pages cannot be mapped with larger ones); with 48-bit virtual addresses,
# four levels of page tables. NUMA, and room for the largest two-socket
# servers (AmpereOne: 2 x 192 cores).
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_NUMA=y
CONFIG_NR_CPUS=512
# 32-bit Arm programs still run (on the processors that can), but without
# their vDSO: it would need clang's 32-bit Arm back end, and joe's LLVM is
# built for AArch64 (and BPF) only. They ask the kernel for the time instead.
# CONFIG_COMPAT_VDSO is not set

# Boot path: the kernel is an EFI application, loaded by systemd-boot. With
# EFI_ZBOOT it is a small EFI program carrying the kernel gzip-compressed,
# which it unpacks and starts (arch/arm64/boot/vmlinuz.efi, 18 MB against
# the plain Image's 49). gzip rather than zstd: QEMU's -kernel unpacks only
# gzip, and zstd at the level the kernel uses (22) takes five times as long
# for a fifth less, longer still in the build root's emulation. Root on
# btrfs.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_ZBOOT=y
CONFIG_KERNEL_GZIP=y
CONFIG_EFIVAR_FS=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_FS_VERITY=y

# The platform of a SystemReady server: ACPI, with the firmware's reports of
# hardware errors (APEI); the GICv3 interrupt controller with its ITS (the
# MSIs of PCIe devices); PCIe through generic ECAM host bridges (ACPI's MCFG
# table, which arm64 supports by itself, or the device tree's
# pci-host-ecam-generic of QEMU's virt machine); and the SMMU (IOMMU). The
# SMMU is built in because the devices behind it wait for its driver before
# they probe, and the root's disk must appear before the kernel mounts it.
# The older SMMU (v1 and v2) is on older servers (Cavium ThunderX, AMD
# Seattle).
CONFIG_ACPI=y
CONFIG_ACPI_APEI=y
CONFIG_ACPI_APEI_GHES=y
CONFIG_ARM_GIC_V3=y
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_ARM_SMMU_V3=y
CONFIG_ARM_SMMU=y

# Consoles: the serial port the firmware names, in ACPI's SPCR table or the
# device tree's stdout-path, which the kernel uses when no console= is
# given, and from the first line on with "earlycon". PL011 (QEMU, Ampere,
# Azure, Oracle, Hetzner) and 8250/16550 (AWS Graviton's ttyS0), on PCI
# too; ACPI describes a plain 16550 as a PNP0501 device, which only the PNP
# driver binds. hvc0 for virtio consoles.
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_PNP=y
CONFIG_SERIAL_8250_PNP=y
CONFIG_VIRTIO_CONSOLE=y

# A console on the display of the BMC or the virtual machine, when there is
# one: the framebuffer the firmware set up, without a graphics driver.
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Storage controllers that may hold the root file system: NVMe (bare metal,
# AWS, Azure, Google), AHCI, Broadcom (LSI) SAS and RAID adapters, virtio
# (QEMU and KVM clouds) and Hyper-V's virtual SCSI (Azure).
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI_MPT3SAS=y
CONFIG_MEGARAID_SAS=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y
CONFIG_HYPERV_STORAGE=y

# The live medium: an ISO 9660 file system on a CD or USB stick (on a server,
# usually the BMC's virtual media, which is a USB device) holding a SquashFS
# root image (xz, with the arm64 filter: mksquashfs -Xbcj arm64), mounted by
# its initramfs, which loads no modules, with a writable layer in memory over
# it. USB sticks that speak UAS appear only with its driver.
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_SR=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_XZ_DEC=y
CONFIG_XZ_DEC_ARM64=y
# erofs images (erofs-utils makes them) mount with the module.
CONFIG_EROFS_FS=m
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# The EFI system partition.
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Virtual machines: network, memory, entropy, a directory of the host shared
# with the guest. Watchdogs: the SBSA generic watchdog servers have, and
# QEMU's i6300esb.
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_FS=y
CONFIG_WATCHDOG=y
CONFIG_ARM_SBSA_WATCHDOG=y
CONFIG_I6300ESB_WDT=y

# Clocks: the PL031 of QEMU's virt machine, and the firmware's.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y
CONFIG_RTC_DRV_EFI=y

# The kernel's last words after a crash, kept for the next boot: in the
# firmware's error record store (ACPI ERST, on servers) or else in EFI
# variables. Writing EFI variables is off unless the kernel is booted with
# efi_pstore.pstore_disable=0: nothing on joe deletes the records once they
# are read (systemd-pstore does that elsewhere), and repeated crashes would
# fill the firmware's variable store.
CONFIG_PSTORE=y
CONFIG_EFI_VARS_PSTORE=y
CONFIG_EFI_VARS_PSTORE_DEFAULT_DISABLE=y

# FUSE (sshfs, rclone, fuse-overlayfs) and the keyboard and mouse a BMC's
# remote console presents over USB.
CONFIG_FUSE_FS=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# What the init system (dynamod), containers and their tools require or
# strongly recommend: systemd's list, which joe Linux keeps.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CPUSETS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_DMIID=y
CONFIG_BLK_DEV_BSG=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_PSI=y
# A kernel debugging aid that prints to the console during normal operation.
# CONFIG_DEBUG_STACK_USAGE is not set
# CONFIG_SYSFS_DEPRECATED is not set
# Without udev's old firmware helper, a missing firmware file would stall
# its driver for a minute.
# CONFIG_FW_LOADER_USER_HELPER is not set

CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
# The socket hooks, which the joe module uses to confine network access.
# Its Kconfig does not select them; x86_64_defconfig has them anyway (for
# SELinux), arm64's defconfig does not.
CONFIG_SECURITY_NETWORK=y

# The joe security module (packages/linux/joe-lsm). It logs violations unless
# booted with joe=enforce. Of the others CONFIG_LSM names, only those built
# in start, and defconfig builds none of them (nor does x86_64_defconfig for
# joe Linux): what runs is capability and joe.
CONFIG_SECURITY_JOE=y
CONFIG_LSM="landlock,lockdown,yama,joe,bpf"

# Module signing is off: the security module checks that a module is sealed
# before it is loaded. Debugging information (which defconfig turns on) is
# off too: nothing ships vmlinux, modules are installed stripped, and it
# makes the build much larger and slower. BTF would need pahole, which joe
# does not have.
# CONFIG_MODULE_SIG is not set
# CONFIG_INTEGRITY is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set

# Not for servers: sound, graphics processors, radios (Wi-Fi, Bluetooth,
# mobile broadband, NFC), cameras and TV, touchscreens. defconfig has them
# for the boards and phones it also covers.
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_WWAN is not set
# CONFIG_NFC is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_INPUT_TOUCHSCREEN is not set

# ---------------------------------------------------------------------------
# Servers. Installed systems have no initramfs, so whatever holds the root is
# built in; whatever needs firmware is a module, loaded by udev once the root
# (and /usr/lib/firmware) is there. Firmware files may be zstd-compressed, as
# joe Linux installs them.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Network adapters of servers and clouds, all modules: Amazon ENA (AWS),
# Google gVNIC, Microsoft MANA and Hyper-V's virtual network, with the
# Hyper-V PCI bus that passes Mellanox and MANA adapters through to the
# guest (Azure); Mellanox ConnectX, Intel (ixgbe, i40e, ice, igb, igc,
# e1000e for QEMU's emulated one, and their virtual functions), Broadcom
# NetXtreme (bnxt, tg3), Cavium ThunderX, HiSilicon HNS3 (Kunpeng), Realtek,
# VMware's vmxnet3; adapters on USB.
CONFIG_ENA_ETHERNET=m
CONFIG_NET_VENDOR_GOOGLE=y
CONFIG_GVE=m
CONFIG_PCI_HYPERV=m
CONFIG_HYPERV_NET=m
CONFIG_NET_VENDOR_MICROSOFT=y
CONFIG_MICROSOFT_MANA=m
CONFIG_MLX5_CORE=m
CONFIG_MLX5_CORE_EN=y
CONFIG_IXGBE=m
CONFIG_IXGBEVF=m
CONFIG_I40E=m
CONFIG_I40EVF=m
CONFIG_ICE=m
CONFIG_IGB=m
CONFIG_IGBVF=m
CONFIG_IGC=m
CONFIG_E1000E=m
CONFIG_BNXT=m
CONFIG_TIGON3=m
CONFIG_THUNDER_NIC_PF=m
CONFIG_THUNDER_NIC_VF=m
CONFIG_HNS3=m
CONFIG_HNS3_HCLGE=m
CONFIG_HNS3_ENET=m
CONFIG_R8169=m
CONFIG_VMXNET3=m
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_AX88179_178A=m

# A guest of Hyper-V (Azure): its services (shutdown, time, key-value
# exchange, which reports to its daemon through the connector), memory
# ballooning and vsock.
CONFIG_CONNECTOR=y
CONFIG_HYPERV_UTILS=m
CONFIG_HYPERV_BALLOON=m
CONFIG_HYPERV_VSOCKETS=m

# Disks that do not hold the root: encryption (cryptsetup, which also uses
# the kernel's ciphers through AF_ALG), LVM snapshots and thin pools,
# software RAID.
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_DM_SNAPSHOT=m
CONFIG_DM_THIN_PROVISIONING=m
CONFIG_BLK_DEV_MD=m
CONFIG_MD_RAID1=m
CONFIG_MD_RAID10=m
CONFIG_MD_RAID456=m
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# VPNs: WireGuard (wireguard-tools), and the TUN/TAP devices OpenVPN uses.
# Policy routing, which wg-quick and tailscale route through (and VRFs,
# below, need), with multipath routes.
CONFIG_WIREGUARD=m
CONFIG_TUN=m
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y

# Servers' TCP: SYN cookies against SYN floods, MD5 signatures for BGP
# sessions (bird, FRR).
CONFIG_SYN_COOKIES=y
CONFIG_TCP_MD5SIG=y

# Firewalls (nftables): the tables, and the expressions rulesets commonly use.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_COMPAT=m

# Network file systems: SMB shares (cifs-utils) and the NFS server
# (nfs-utils); the NFS client is part of defconfig.
CONFIG_CIFS=m
CONFIG_NFSD=m
CONFIG_NFSD_V4=y

# ---------------------------------------------------------------------------
# Containers, virtual machines, VPNs and firewalls: what docker, podman,
# Kubernetes, libvirt and QEMU, strongswan, ppp, firewalld, fail2ban and the
# xtables rules that iptables-nft translates need. Modules, unless an option
# is only a switch.

# Netfilter beyond the basics: the xtables matches and targets iptables-nft
# uses, the connection-tracking helpers firewalld's services name, the
# conntrack netlink interfaces, IP sets and IPVS (kube-proxy).
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE_NETFILTER=m
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_NETLINK_GLUE_CT=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMESTAMP=y
CONFIG_NF_CONNTRACK_LABELS=y
CONFIG_NF_CONNTRACK_AMANDA=m
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_CONNTRACK_H323=m
CONFIG_NF_CONNTRACK_NETBIOS_NS=m
CONFIG_NF_CONNTRACK_SNMP=m
CONFIG_NF_CONNTRACK_PPTP=m
CONFIG_NF_CONNTRACK_SANE=m
CONFIG_NF_CONNTRACK_SIP=m
CONFIG_NF_CONNTRACK_TFTP=m
CONFIG_NF_CT_NETLINK=m
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CT_NETLINK_TIMEOUT=m
CONFIG_NF_CT_NETLINK_HELPER=m
CONFIG_NF_FLOW_TABLE=m
CONFIG_NF_FLOW_TABLE_INET=m
CONFIG_NF_TABLES_BRIDGE=m
CONFIG_NFT_FLOW_OFFLOAD=m
CONFIG_NFT_NUMGEN=m
CONFIG_NFT_FWD_NETDEV=m
CONFIG_NFT_XFRM=m
CONFIG_NFT_OSF=m
CONFIG_NFT_TPROXY=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_SET=m
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_CONNLABEL=m
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=m
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_OSF=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_POLICY=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_IP6_NF_MATCH_RT=m
CONFIG_IP_SET=m
CONFIG_IP_SET_BITMAP_PORT=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_IPPORT=m
CONFIG_IP_SET_HASH_IPPORTIP=m
CONFIG_IP_SET_HASH_IPPORTNET=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_IP_SET_HASH_NETPORT=m
CONFIG_IP_SET_LIST_SET=m
CONFIG_IP_VS=m
CONFIG_IP_VS_IPV6=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_PROTO_SCTP=y
CONFIG_IP_VS_RR=m
CONFIG_IP_VS_WRR=m
CONFIG_IP_VS_LC=m
CONFIG_IP_VS_SH=m
CONFIG_IP_VS_NFCT=y

# The virtual network devices containers and virtual machines are wired
# with, and policy routing (tailscale, strongswan, VRFs).
CONFIG_BRIDGE=m
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_BRIDGE_NF_EBTABLES=m
CONFIG_VLAN_8021Q=m
CONFIG_VETH=m
CONFIG_DUMMY=m
CONFIG_MACVLAN=m
CONFIG_MACVTAP=m
CONFIG_IPVLAN=m
CONFIG_IPVTAP=m
CONFIG_VXLAN=m
CONFIG_GENEVE=m
CONFIG_IFB=m
CONFIG_NET_L3_MASTER_DEV=y
CONFIG_NET_VRF=m
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP_SCTP=m

# Traffic control: libvirt's and CNI's bandwidth limits, eBPF-based CNIs.
CONFIG_NET_SCH_HTB=m
CONFIG_NET_SCH_TBF=m
CONFIG_NET_SCH_SFQ=m
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_U32=m
CONFIG_NET_CLS_FW=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_POLICE=m
CONFIG_NET_ACT_MIRRED=m
CONFIG_NET_ACT_BPF=m

# IPsec (strongswan, docker's encrypted overlay networks), configured
# through the xfrm netlink interface. The AES and GHASH instructions of the
# processor are used through defconfig's arm64 ciphers.
CONFIG_XFRM_USER=m
CONFIG_INET_AH=m
CONFIG_INET_ESP=m
CONFIG_INET_ESPINTCP=y
CONFIG_INET_IPCOMP=m
CONFIG_INET6_AH=m
CONFIG_INET6_ESP=m
CONFIG_INET6_ESPINTCP=y
CONFIG_INET6_IPCOMP=m
CONFIG_XFRM_INTERFACE=m
CONFIG_XFRM_MIGRATE=y
CONFIG_NET_IPVTI=m
CONFIG_IPV6_VTI=m
CONFIG_CRYPTO_CHACHA20POLY1305=m
CONFIG_CRYPTO_XCBC=m
CONFIG_CRYPTO_DEFLATE=m

# PPP (ppp, openfortivpn, PPPoE) and L2TP.
CONFIG_PPP=m
CONFIG_PPP_ASYNC=m
CONFIG_PPP_SYNC_TTY=m
CONFIG_PPP_DEFLATE=m
CONFIG_PPP_BSDCOMP=m
CONFIG_PPP_MPPE=m
CONFIG_PPP_FILTER=y
CONFIG_PPP_MULTILINK=y
CONFIG_PPPOE=m
CONFIG_SERIAL_NONSTANDARD=y
CONFIG_N_HDLC=m
CONFIG_L2TP=m
CONFIG_L2TP_V3=y
CONFIG_L2TP_IP=m
CONFIG_L2TP_ETH=m
CONFIG_PPPOL2TP=m

# A virtual machine host (libvirt, QEMU): KVM (on arm64 it can only be built
# in), vhost, vsock, device passthrough, NBD exports; I/O limits and
# checkpointing for containers; compiled BPF for seccomp filters and tc.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=m
CONFIG_VSOCKETS=m
CONFIG_VSOCKETS_DIAG=m
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_BLK_DEV_NBD=m
CONFIG_KSM=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_BPF_JIT=y
# Containers of other architectures (qemu-user, registered by binfmt_misc).
CONFIG_BINFMT_MISC=m

# What perf and bpftrace attach to: kernel and user probes, trace events.
CONFIG_KPROBES=y
CONFIG_FTRACE=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y

# Kernel messages over the network, from servers without a serial console
# anyone reads.
CONFIG_NETCONSOLE=m

# A guest of QEMU (vsock, firmware configuration), and Azure's provisioning
# media (cloud-init).
CONFIG_VIRTIO_VSOCKETS=m
CONFIG_FW_CFG_SYSFS=m
CONFIG_UDF_FS=m

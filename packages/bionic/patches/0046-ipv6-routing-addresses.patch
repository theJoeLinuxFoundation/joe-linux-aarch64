joe Linux: expose the trailing addresses of the IPv6 type 0 routing header.
nftables uses their offsets when decoding routing-header fields.

diff --git a/libc/include/netinet/ip6.h b/libc/include/netinet/ip6.h
index ed7eace..3abe499 100644
--- a/libc/include/netinet/ip6.h
+++ b/libc/include/netinet/ip6.h
@@ -216,6 +216,7 @@ struct ip6_rthdr0 {
 	u_int8_t  ip6r0_type;		/* always zero */
 	u_int8_t  ip6r0_segleft;	/* segments left */
 	u_int32_t ip6r0_reserved;	/* reserved field */
+	struct in6_addr ip6r0_addr[0];	/* addresses following the header */
 } __packed;
 
 /* Fragment header */

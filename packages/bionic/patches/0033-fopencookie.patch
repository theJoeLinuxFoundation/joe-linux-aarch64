 #endif
 
+#if defined(__USE_GNU)
+/*
+ * joe Linux: glibc's custom streams. fopencookie(3) makes a stream whose reads, writes, seeks and
+ * close call the given functions with the cookie; a function left null makes the stream read as
+ * at its end, throw away what it is given, or fail to seek.
+ */
+typedef ssize_t cookie_read_function_t(void* _Nullable __cookie, char* _Nonnull __buf, size_t __n);
+typedef ssize_t cookie_write_function_t(void* _Nullable __cookie, const char* _Nonnull __buf, size_t __n);
+typedef int cookie_seek_function_t(void* _Nullable __cookie, off64_t* _Nonnull __offset, int __whence);
+typedef int cookie_close_function_t(void* _Nullable __cookie);
+
+typedef struct _IO_cookie_io_functions_t {
+  cookie_read_function_t* _Nullable read;
+  cookie_write_function_t* _Nullable write;
+  cookie_seek_function_t* _Nullable seek;
+  cookie_close_function_t* _Nullable close;
+} cookie_io_functions_t;
+
+/**
+ * [fopencookie(3)](https://man7.org/linux/man-pages/man3/fopencookie.3.html) opens a stream
+ * on the given functions, with the access fopen()'s `mode` gives.
+ *
+ * Returns the stream on success, and returns NULL and sets `errno` on failure.
+ */
+__nodiscard FILE* _Nullable fopencookie(void* _Nullable __cookie, const char* _Nonnull __mode, cookie_io_functions_t __funcs);
+#endif
+
 __nodiscard FILE* _Nullable fopen(const char* _Nonnull __path, const char* _Nonnull __mode);
 

.{
    .name = "jq",
    .version = "1.8.2",
    .release = 1,
    .description = "Command-line JSON processor",
    .license = "MIT AND ICU AND LicenseRef-dtoa",
    .sources = .{
        // Checked against upstream's sha256sum.txt for the release.
        .{ .url = "https://github.com/jqlang/jq/releases/download/jq-1.8.2/jq-1.8.2.tar.gz", .sha256 = "71b8d6e8f5fe81f6c6d0d110e3892251f6ce76ed095abd315e26e6e1193af3af" },
    },
    // oniguruma for regular expressions (test, match, sub and so on).
    // decNumber (ICU license) for exact big numbers, and David Gay's dtoa,
    // are built in from the tarball.
    .depends = .{ "bionic", "oniguruma" },
    .build_depends = .{"pkgconf"},
}

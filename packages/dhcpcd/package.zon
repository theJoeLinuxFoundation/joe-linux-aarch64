.{
    .name = "dhcpcd",
    .version = "10.5.2",
    .release = 2,
    .description = "DHCP, IPv4LL, IPv6 router solicitation and DHCPv6 client",
    .license = "BSD-2-Clause",
    .sources = .{
        .{ .url = "https://github.com/NetworkConfiguration/dhcpcd/releases/download/v10.5.2/dhcpcd-10.5.2.tar.xz", .sha256 = "3e476657fdb6eeb38b277da3a48d0ac0113ecce5858ebdcddff2b629faed52b4" },
    },
    // eudev: libudev, for the plugin that waits for interfaces to be named.
    // The hooks are shell scripts run by dhcpcd-run-hooks.
    .depends = .{ "bionic", "eudev", "openssl", "bash" },
    .build_depends = .{"pkgconf"},
}

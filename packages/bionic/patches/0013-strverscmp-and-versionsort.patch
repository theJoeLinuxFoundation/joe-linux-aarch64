+// joe Linux: strverscmp(3) and versionsort(3), the GNU functions that order
+// names the way people number versions ("lib9" before "lib10"). glibc and
+// musl have them; util-linux's lsmem and chmem sort sysfs entries with them,
+// and libmount and login read configuration directories in their order.
+//
+// The algorithm is musl's (src/string/strverscmp.c, MIT license, Copyright
+// 2005-2020 Rich Felker, et al.), which gives glibc's documented order: digit
+// sequences compare as numbers, and one that begins with a zero is a
+// fraction, which sorts before any number ("000" < "00" < "01" < "010" <
+// "09" < "0" < "1" < "9" < "10").
+
+#include <ctype.h>
+#include <dirent.h>
+#include <string.h>
+
+int strverscmp(const char* lhs, const char* rhs) {
+  const unsigned char* l = reinterpret_cast<const unsigned char*>(lhs);
+  const unsigned char* r = reinterpret_cast<const unsigned char*>(rhs);
+
+  // The common prefix, where the digit sequence it ends in begins (`run`),
+  // and whether that sequence is all zeros so far.
+  size_t i = 0, run = 0;
+  bool zeros = true;
+  for (; l[i] == r[i]; i++) {
+    if (l[i] == '\0') return 0;
+    if (!isdigit(l[i])) {
+      run = i + 1;
+      zeros = true;
+    } else if (l[i] != '0') {
+      zeros = false;
+    }
+  }
+
+  if (l[run] - '1' < 9U && r[run] - '1' < 9U) {
+    // Two numbers (no leading zero): the one with more digits is greater;
+    // with as many, the first digit that differs decides.
+    size_t j = i;
+    for (; isdigit(l[j]); j++) {
+      if (!isdigit(r[j])) return 1;
+    }
+    if (isdigit(r[j])) return -1;
+  } else if (zeros && run < i && (isdigit(l[i]) || isdigit(r[i]))) {
+    // Two fractions with the same leading zeros: a digit sorts before
+    // anything else, since the longer fraction is the smaller one.
+    return static_cast<unsigned char>(l[i] - '0') - static_cast<unsigned char>(r[i] - '0');
+  }
+  return l[i] - r[i];
+}
+
+int versionsort(const dirent** lhs, const dirent** rhs) {
+  return strverscmp((*lhs)->d_name, (*rhs)->d_name);
+}
+__strong_alias(versionsort64, versionsort);

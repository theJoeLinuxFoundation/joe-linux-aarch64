@@ -228,6 +228,25 @@
 /*								    */
 /* **************************************************************** */
 
+/* joe Linux. Before running a script file, ask the joe security module
+   whether this process may: a privileged process may run only sealed files.
+   The module answers a request no file system implements, so the only
+   refusal is EACCES; ENOTTY (also what a kernel without the module returns)
+   and anything else mean there is no objection. */
+#include <sys/ioctl.h>
+#define JOE_IOC_CHECK_SCRIPT 0xE701	/* _IO(0xE7, 0x01) */
+
+int
+joe_script_refused (int fd)
+{
+  int r, e;
+
+  e = errno;
+  r = ioctl (fd, JOE_IOC_CHECK_SCRIPT) < 0 && errno == EACCES;
+  errno = e;
+  return r;
+}
+
 /* Return non-zero if all of the characters in STRING are digits. */

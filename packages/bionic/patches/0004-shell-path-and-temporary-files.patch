joe Linux: /bin/sh, a Linux default PATH, and /tmp for temporary files.

diff --git i/libc/bionic/tmpfile.cpp w/libc/bionic/tmpfile.cpp
index 4d6a1fb..4d86aed 100644
--- i/libc/bionic/tmpfile.cpp
+++ w/libc/bionic/tmpfile.cpp
@@ -83,10 +83,9 @@ static FILE* __tmpfile_dir_legacy(const char* tmp_dir) {
 }
 
 const char* __get_TMPDIR() {
-  // Use $TMPDIR if set, or fall back to /data/local/tmp otherwise.
-  // Useless for apps, but good enough for the shell.
+  // Use $TMPDIR if set, or fall back to /tmp otherwise.
   const char* tmpdir = getenv("TMPDIR");
-  return (tmpdir == nullptr) ? "/data/local/tmp" : tmpdir;
+  return (tmpdir == nullptr) ? "/tmp" : tmpdir;
 }
 
 FILE* tmpfile() {
@@ -107,8 +106,7 @@ char* tempnam(const char* dir, const char* prefix) {
   if (tmpdir != nullptr) dir = tmpdir;
 
   // If we still have no directory, we'll give you a default.
-  // It's useless for apps, but good enough for the shell.
-  if (dir == nullptr) dir = "/data/local/tmp";
+  if (dir == nullptr) dir = "/tmp";
 
   // Default prefix?
   if (prefix == nullptr) prefix = "tempnam.";
